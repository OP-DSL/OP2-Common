      "hypre": {"solver": "PCG", "Tol": 1e-12, "MaxIter": 5000},
      "ginkgo": {"type": "solver::Cg", "criteria": {"iteration": 5000, "relative_residual_norm": 1e-12}},
      "rocalution": {"solver": "CG", "rel_tol": 1e-12, "max_iter": 5000},
      "mock": {"solver": "cg", "rtol": 1e-12, "maxit": 5000}
    }

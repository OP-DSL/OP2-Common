    {% if staged %}
    const int *__restrict source_offsets,
    const unsigned int *__restrict stage_words,
    const int *__restrict stage_counts,
    const int chunk_begin,
    const int chunk_end
    {% endif %}
) {
    using namespace op2_m_{{lh.name}}{{variant}};
    int thread_id = threadIdx.x + blockIdx.x * blockDim.x;

    [[maybe_unused]] int zero_int = 0;
    [[maybe_unused]] bool zero_bool = 0;
    [[maybe_unused]] float zero_float = 0;
    [[maybe_unused]] double zero_double = 0;

    {% if staged %}
    (void)start;
    (void)end;
    (void)thread_id;
{{hier_smem_body(jit)}}
}
    {% else %}
    for (int i = thread_id + start; i < end; i += blockDim.x * gridDim.x) {
    {% if lh is indirect and config.color2 %}
        int n = col_reord[i];
    {% else %}
        int n = i;
    {% endif %}

    {% if lh.args|idx|direct|length > 0 %}
        int idx = n + 1;
    {% endif %}

    {% for arg in lh.args|idx|indirect %}
        int idx{{arg.id}} = {{map_lookup(arg)}} + 1;
    {% endfor %}

        {{lh.kernel}}(
    {% for arg in lh.args %}
            {{arg_to_pointer_cuda(arg, jit)}}{{"," if not loop.last}}
    {% endfor %}
        );
    }
}
    {% endif %}
{% endmacro %}


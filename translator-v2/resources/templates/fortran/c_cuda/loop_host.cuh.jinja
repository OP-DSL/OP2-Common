    {% for dat in lh.dats if dat.dim is none and (dat is not soa or (staged and dat.id in hier_smem.dat_ids)) %}
    const int dat{{dat.id}}_dim,
    {% endfor %}
    {% for arg in lh.args|runtime_map_idx %}

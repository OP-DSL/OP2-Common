{%- if config.hip -%}
    {% set api_prefix = "hip" %}
{%- else -%}
    {% set api_prefix = "cuda" %}
{%- endif -%}

{%- macro variant_str() -%}
{{"Direct" if lh is direct else "Indirect"}}
{%- endmacro -%}

{%- set strategies = config.strategies -%}

{%- set args_gbl_per_thread = lh.args|gbl|select2("reduction", "work")|list -%}
{%- if config.gbl_inc_atomic -%}
    {%- set args_gbl_per_thread = args_gbl_per_thread|reject("inc")|list -%}
{%- endif -%}

{#- Argument groups for the hierarchical strategies, with their dat ids in
    first-use order.  hier_atomics stages every indirect increment;
    hier_colouring colours every indirect argument on a dat the loop
    increments or read-writes.  The translator lists a hierarchical strategy
    only when its group arguments have one map component and a supported
    scalar type. -#}
{%- set args_hier_atomics = lh.args|dat|indirect(lh)|inc|list -%}
{%- set updated = namespace(ids=[]) -%}
{%- for arg in lh.args|dat|indirect(lh) -%}
    {%- if (arg is inc or arg is read_write) and arg.dat_id not in updated.ids -%}
        {%- set updated.ids = updated.ids + [arg.dat_id] -%}
    {%- endif -%}
{%- endfor -%}
{%- set args_hier_colouring = lh.args|dat|indirect(lh)|selectattr("dat_id", "in", updated.ids)|list -%}
{%- set group_ids = namespace(hier_atomics=[], hier_colouring=[]) -%}
{%- for arg in args_hier_atomics -%}
    {%- if arg.dat_id not in group_ids.hier_atomics -%}
        {%- set group_ids.hier_atomics = group_ids.hier_atomics + [arg.dat_id] -%}
    {%- endif -%}
{%- endfor -%}
{%- for arg in args_hier_colouring -%}
    {%- if arg.dat_id not in group_ids.hier_colouring -%}
        {%- set group_ids.hier_colouring = group_ids.hier_colouring + [arg.dat_id] -%}
    {%- endif -%}
{%- endfor -%}
{#- Dats the loop only reads, through indirect arguments a plan can group.
    Both hierarchical strategies list them as read-only groups after their own,
    staged at run time when OP_HIER_<STRATEGY>_STAGE_READS asks, so a chunk
    gathers each target once.  Every argument on such a dat must be groupable,
    since an ungrouped one on a grouped dat is rejected. -#}
{%- set read_groups = namespace(ids=[], args=[]) -%}
{%- for dat in lh.dats if dat is read_in(lh) -%}
    {%- set dat_args = lh.args|dat|selectattr("dat_id", "eq", dat.id)|list -%}
    {%- set eligible = namespace(ok=dat_args|length > 0) -%}
    {%- for arg in dat_args -%}
        {%- set typ = dat.typ -%}
        {%- if arg is not indirect(lh) or arg is vec or not ((typ is instance(OP.Float) and typ.size in [32, 64]) or (typ is instance(OP.Int) and typ.signed and typ.size == 32)) -%}
            {%- set eligible.ok = false -%}
        {%- endif -%}
    {%- endfor -%}
    {%- if eligible.ok -%}
        {%- set read_groups.ids = read_groups.ids + [dat.id] -%}
        {%- set read_groups.args = read_groups.args + dat_args -%}
    {%- endif -%}
{%- endfor -%}
{%- set args_hier_reads = lh.args|select("in", read_groups.args)|list -%}

{#- Direct arguments on dats the loop only reads, which hierarchical colouring
    stages per chunk when OP_HIER_COLOURING_STAGE_DIRECT asks. -#}
{%- set direct_reads = namespace(args=[]) -%}
{%- for arg in lh.args|dat|direct(lh) -%}
    {%- set typ = lh.dat(arg).typ -%}
    {%- if lh.dat(arg) is read_in(lh) and ((typ is instance(OP.Float) and typ.size in [32, 64]) or (typ is instance(OP.Int) and typ.signed and typ.size == 32)) -%}
        {%- set direct_reads.args = direct_reads.args + [arg] -%}
    {%- endif -%}
{%- endfor -%}
{%- set args_direct_reads = direct_reads.args -%}

{%- set group_args = {"hier_atomics": args_hier_atomics + args_hier_reads, "hier_colouring": args_hier_colouring + args_hier_reads} -%}
{%- set group_dats = {"hier_atomics": group_ids.hier_atomics + read_groups.ids, "hier_colouring": group_ids.hier_colouring + read_groups.ids} -%}
{#- SoA dats whose runtime dimension a hierarchical wrapper takes: its groups,
    and for colouring the direct reads it can stage. -#}
{%- set dim_dats = {"hier_atomics": group_dats.hier_atomics, "hier_colouring": group_dats.hier_colouring + args_direct_reads|map(attribute="dat_id")|list} -%}

{#- Whether hierarchical colouring can compute every element of a chunk at
    once: its groups only increment and read, so each thread can keep its
    increments in registers until its colour's turn.  Runtime dimensions are
    bounded by f2c::hier_max_local_dim; a larger one, or
    OP_HIER_COLOURING_SERIAL, runs the serialised shape instead. -#}
{%- set colour_shape = namespace(parallel=true) -%}
{%- for arg in args_hier_colouring -%}
    {%- if not (arg is inc or arg is read) -%}
        {%- set colour_shape.parallel = false -%}
    {%- endif -%}
{%- endfor -%}
{%- set hier_colouring_parallel = colour_shape.parallel -%}

{#- How each strategy applies the translated kernel's op2_inc calls. -#}
{%- macro inc_hook(strategy) -%}
    {%- if strategy != "plain" %}
template<typename T, typename U>
static __device__ inline void op2_inc(T& target, U value) {
    f2c::{{"atomic_inc" if strategy in ["atomics", "hier_atomics"] else "plain_inc"}}(target, value);
}
    {% endif -%}
{%- endmacro -%}

{#- The translated kernel, in a namespace of its own for each strategy, or
    for just the one a JIT source compiles. -#}
{%- macro kernel_namespaces(only = none) -%}
    {%- for strategy in strategies if only is none or strategy == only %}
namespace op2_s_{{strategy}} {
{{inc_hook(strategy)}}
{{kernel_func}}}

    {% endfor -%}
{%- endmacro -%}

{%- macro gbl_dim_w(arg) -%}
    {%- if arg.dim is not none -%}
{{arg.dim}}
    {%- else -%}
arg{{arg.id}}_dim
    {%- endif -%}
{%- endmacro -%}

{%- macro dat_dim_w(dat) -%}
    {%- if dat.dim is not none -%}
{{dat.dim}}
    {%- else -%}
dat{{dat.id}}_dim
    {%- endif -%}
{%- endmacro -%}

{%- macro hier_smem_scalar_type(dat) -%}
    {%- if dat.typ is instance(OP.Float) -%}
op::f2c::HierScalarType::f{{dat.typ.size}}
    {%- else -%}
op::f2c::HierScalarType::i32
    {%- endif -%}
{%- endmacro -%}

{%- macro map_idx(arg) -%}
    {%- if arg is runtime_map_idx %}
arg{{arg.id}}_idx
    {%- else -%}
{{arg.map_idx - 1}}
    {%- endif -%}
{%- endmacro -%}

{% macro map_lookup(arg) -%}
map{{arg.map_id}}[{{map_idx(arg)}} * stride + n]
{%- endmacro %}

{%- macro arg_to_pointer_cuda(arg, jit = false, staged = none, local = false, preloaded = false) %}
    {%- if arg is idx and arg is indirect -%}
idx{{arg.id}}
    {%- elif arg is idx -%}
idx
    {%- elif arg is opt and arg is scalar(lh) -%}
        {%- if arg is gbl or arg is info %}
            {%- set zero_type = arg.typ.c() -%}
        {%- else -%}
            {%- set zero_type = lh.dat(arg).typ.c() -%}
        {%- endif -%}
(1 << {{lh.optIdx(arg)}}) & opt_flags ? {{arg_to_pointer2(arg, jit, staged, local, preloaded)}} : zero_{{zero_type}}
    {%- else -%}
{{arg_to_pointer2(arg, jit, staged, local, preloaded)}}
    {%- endif -%}
{%- endmacro -%}

{%- macro arg_to_pointer2(arg, jit, staged = none, local = false, preloaded = false) -%}
    {%- if jit and arg is gbl and arg is read and arg is scalar -%}
op2_gbl{{arg.id}}_d
    {%- elif arg is gbl and arg is read and arg is scalar -%}
gbl{{arg.id}}
    {%- elif arg is scalar(lh) -%}
{{arg_to_pointer3(arg, staged, local, preloaded)}}.data[0]
    {%- else -%}
{{arg_to_pointer3(arg, staged, local, preloaded)}}
    {%- endif -%}
{%- endmacro -%}

{%- macro arg_to_pointer3(arg, staged = none, local = false, preloaded = false) -%}
    {%- if arg is info -%}
f2c::Ptr{info{{arg.id}} + thread_id, stride_gbl}
    {%- elif arg in args_gbl_per_thread -%}
f2c::Ptr{gbl{{arg.id}} + thread_id, stride_gbl}
    {%- elif arg is gbl -%}
f2c::Ptr{gbl{{arg.id}}}
    {%- else -%}
{{arg_to_pointer4(arg, staged, local, preloaded)}}
    {%- endif -%}
{%- endmacro -%}

{#- A grouped argument's staged slot for element n; the region's slot count
    is the stride between its components.  preloaded reads the slot an
    OP_HIER_COLOURING_PRELOAD pass resolved before the colour passes. -#}
{%- macro hier_smem_slot(arg, strategy, preloaded = false) -%}
    {%- set group = group_dats[strategy]|index(arg.dat_id) -%}
    {%- set index = group_args[strategy]|index(arg) -%}
    {%- if preloaded -%}
f2c::Ptr{op2_stage{{group}} + ((op2_variants & f2c::hier_variant_preload) ? op2_slot{{index}} : f2c::hier_smem_stage_slot(stage_words[{{index}} * stride + n])), op2_stage{{group}}_count}
    {%- else -%}
f2c::Ptr{op2_stage{{group}} + f2c::hier_smem_stage_slot(stage_words[{{index}} * stride + n]), op2_stage{{group}}_count}
    {%- endif -%}
{%- endmacro -%}

{#- An argument's global data for element n. -#}
{%- macro arg_global_pointer(arg) -%}
    {%- if arg is direct and lh.dat(arg) is soa -%}
f2c::Ptr{dat{{arg.dat_id}} + n, op2_stride_direct_d}
    {%- elif arg is direct -%}
f2c::Ptr{dat{{arg.dat_id}} + n * {{dat_dim_w(lh.dat(arg))}}}
    {%- elif lh.dat(arg) is soa -%}
f2c::Ptr{dat{{arg.dat_id}} + {{map_lookup(arg)}}, op2_stride_dat{{arg.dat_id}}_d}
    {%- else -%}
f2c::Ptr{dat{{arg.dat_id}} + {{map_lookup(arg)}} * {{dat_dim_w(lh.dat(arg))}}}
    {%- endif -%}
{%- endmacro -%}

{#- staged names the strategy whose group arguments point at their staged
    slots; read-only and direct arguments do only when their variant staged
    them.  local points the indirect increments at per-thread registers. -#}
{%- macro arg_to_pointer4(arg, staged = none, local = false, preloaded = false) -%}
    {%- if local and arg in args_hier_atomics -%}
f2c::Ptr{op2_local{{arg.id}}}
    {%- elif staged is not none and arg in args_hier_reads -%}
((op2_variants & f2c::hier_variant_stage_reads) ? {{hier_smem_slot(arg, staged, preloaded)}} : {{arg_global_pointer(arg)}})
    {%- elif staged is not none and arg in group_args[staged] -%}
{{hier_smem_slot(arg, staged, preloaded)}}
    {%- elif staged == "hier_colouring" and arg in args_direct_reads -%}
((op2_variants & f2c::hier_variant_stage_direct) ? f2c::Ptr{op2_direct{{arg.id}} + (n - op2_source_begin), op2_chunk_length} : {{arg_global_pointer(arg)}})
    {%- else -%}
{{arg_global_pointer(arg)}}
    {%- endif -%}
{%- endmacro -%}

{#- One call of the translated kernel for element n. -#}
{%- macro kernel_call(jit, staged = none, local = false, preloaded = false) -%}
{% if lh.args|idx|direct|length > 0 %}
int idx = n + 1;
{% endif %}
{% for arg in lh.args|idx|indirect %}
int idx{{arg.id}} = {{map_lookup(arg)}} + 1;
{% endfor %}
{{lh.kernel}}(
{% for arg in lh.args %}
    {{arg_to_pointer_cuda(arg, jit, staged, local, preloaded)}}{{"," if not loop.last}}
{% endfor %}
);
{%- endmacro -%}

{%- macro init_gbls() -%}
op2_k_{{lh.name}}{{variant}}_init_gbls<<<context.max_blocks, context.block_size>>>(
    {% for arg in args_gbl_per_thread %}
    ({{arg.typ.c()}} *)args[{{arg.id}}].data_d,
    {% endfor %}
    {% for arg in args_gbl_per_thread|select2("min", "max", "work") %}
    gbl{{arg.id}}_ref_d,
    {% endfor %}
    {% for arg in args_gbl_per_thread if arg.dim is none %}
    args[{{arg.id}}].dim,
    {% endfor %}
    {% for arg in args_gbl_per_thread if arg is opt %}
    args[{{arg.id}}].opt,
    {% endfor %}
    context.global_stride
);

CUDA_SAFE_CALL({{api_prefix}}PeekAtLastError());
{%- endmacro -%}

namespace op2_m_{{lh.name}}{{variant}} {

{% if lh.dats|direct(lh)|soa|length > 0 %}
int op2_stride_direct;
__constant__ int op2_stride_direct_d;
{% endif %}

{% for dat in lh.dats|indirect(lh)|soa %}
int op2_stride_dat{{dat.id}};
__constant__ int op2_stride_dat{{dat.id}}_d;
{% endfor %}

{% for arg in lh.args|gbl|read|scalar %}
{{arg.typ.c()}} op2_gbl{{arg.id}};
{% endfor %}

{% if "hier_atomics" in strategies or "hier_colouring" in strategies %}
int op2_hier_variants;
__constant__ int op2_hier_variants_d;
{% endif %}
{{kernel_namespaces()}}
}

{#- Whether any argument in a staged group is active for this launch. -#}
{%- macro hier_smem_group_active(strategy, dat_id) -%}
    {%- set members = group_args[strategy]|selectattr("dat_id", "eq", dat_id)|list -%}
    {%- if members|reject("opt")|list|length > 0 -%}
true
    {%- else -%}
        {%- for arg in members -%}
((1 << {{lh.optIdx(arg)}}) & opt_flags) != 0{{" || " if not loop.last}}
        {%- endfor -%}
    {%- endif -%}
{%- endmacro -%}

{#- The owner's global element as an f2c::Ptr; its stride carries the layout,
    so the staging helpers need no AoS/SoA variants. -#}
{%- macro hier_smem_global(arg, dat) -%}
    {%- if dat is soa -%}
f2c::Ptr{dat{{arg.dat_id}} + target, op2_stride_dat{{arg.dat_id}}_d}
    {%- else -%}
f2c::Ptr{dat{{arg.dat_id}} + target * {{dat_dim_w(dat)}}}
    {%- endif -%}
{%- endmacro -%}

{#- Seed every staged region through the single owner of each of its slots,
    in one pass over the chunk, so every argument's loads are in flight at
    once rather than one argument's dependent chain after another's.  The
    same pass copies staged direct data. -#}
{% macro hier_smem_seed_all(strategy, grouped) %}
        for (int n = op2_source_begin + threadIdx.x; n < op2_source_end;
             n += blockDim.x) {
{% for arg in grouped %}
    {% set dat = lh.dat(arg) %}
    {% set group = group_dats[strategy]|index(arg.dat_id) %}
    {% set guards = [] %}
    {% if arg is opt %}
        {% set guards = guards + ["((1 << %d) & opt_flags) != 0" % lh.optIdx(arg)] %}
    {% endif %}
    {% if arg in args_hier_reads %}
        {# Unstaged reads have no slots, so skip their stage words entirely. #}
        {% set guards = guards + ["(op2_variants & f2c::hier_variant_stage_reads) != 0"] %}
    {% endif %}
    {% if guards %}
            if ({{guards|join(" && ")}}) {
    {% else %}
            {
    {% endif %}
                // Only owners are ever marked exclusive, so this covers both.
                f2c::HierSmemStageWord word = stage_words[{{loop.index0}} * stride + n];
                if (f2c::hier_smem_stage_exclusive(word)) {
                    int target = {{map_lookup(arg)}};
                    f2c::hier_smem_seed(word, {{hier_smem_global(arg, dat)}}, op2_stage{{group}}, op2_stage{{group}}_count, {{dat_dim_w(dat)}});
                }
            }
{% endfor %}
{% if strategy == "hier_colouring" %}
    {% for arg in args_direct_reads %}
            if (op2_direct{{arg.id}} != nullptr) {
                auto op2_source = {{arg_global_pointer(arg)}};
                for (int c = 0; c < {{dat_dim_w(lh.dat(arg))}}; ++c)
                    op2_direct{{arg.id}}[c * op2_chunk_length + (n - op2_source_begin)] = op2_source.data[c * op2_source.stride];
            }
    {% endfor %}
{% endif %}
        }
{% endmacro %}

{#- One staged slot flushed back to its global target. -#}
{% macro hier_smem_flush(strategy, arg, index) %}
{% set dat = lh.dat(arg) %}
{% set group = group_dats[strategy]|index(arg.dat_id) %}
        for (int n = op2_source_begin + threadIdx.x; n < op2_source_end;
             n += blockDim.x) {
{% if arg is opt %}
            if (((1 << {{lh.optIdx(arg)}}) & opt_flags) == 0)
                break;

{% endif %}
            f2c::HierSmemStageWord word = stage_words[{{index}} * stride + n];
            if (!f2c::hier_smem_stage_owner(word))
                continue;

            int target = {{map_lookup(arg)}};
            f2c::{{"hier_smem_store" if strategy == "hier_colouring" else "hier_smem_flush"}}(word, {{hier_smem_global(arg, dat)}}, op2_stage{{group}}, op2_stage{{group}}_count, {{dat_dim_w(dat)}});
        }
{% endmacro %}

{#- A block-sized slice of the chunk: this thread's element and colour, and
    the passes the slice needs.  OP_HIER_COLOURING_SORT takes the elements in
    colour order, so a slice holds a contiguous colour range and runs only
    those passes, which keeps chunks larger than a block from paying for every
    colour in every slice. -#}
{%- macro hier_colour_slice() -%}
const int op2_position = op2_base + threadIdx.x;
const bool op2_sorted = (op2_variants & f2c::hier_variant_sort) != 0;
const int op2_n = op2_position >= op2_source_end ? -1
                  : op2_sorted ? element_order[op2_position]
                  : op2_position;
const int op2_colour = op2_n >= 0 ? thread_colours[op2_n] : -1;
const int op2_last = min(op2_base + (int)blockDim.x, op2_source_end) - 1;
const int op2_first_pass = op2_sorted ? thread_colours[element_order[op2_base]] : 0;
const int op2_end_pass = op2_sorted ? thread_colours[element_order[op2_last]] + 1 : op2_colours;
{%- endmacro %}

{#- The parallel shape: every element of a block-sized slice computes at once
    into per-thread increments, then they are added into the staged slots one
    thread colour at a time. -#}
{%- macro hier_colour_parallel_passes(jit) %}
        for (int op2_base = op2_source_begin; op2_base < op2_source_end;
             op2_base += blockDim.x) {
            {{hier_colour_slice()|indent(12)}}
            const int n = op2_n;
    {% for arg in args_hier_atomics %}
            {{lh.dat(arg).typ.c()}} op2_local{{arg.id}}[{{lh.dat(arg).dim if lh.dat(arg).dim is not none else "f2c::hier_max_local_dim"}}] = {};
    {% endfor %}

            if (op2_colour >= 0) {
                {{kernel_call(jit, "hier_colouring", true)|indent(16)}}
            }

            // Every staged read completes before any slot changes.
            __syncthreads();

            for (int op2_pass = op2_first_pass; op2_pass < op2_end_pass; ++op2_pass) {
                if (op2_colour == op2_pass) {
    {% for arg in args_hier_atomics %}
        {% if arg is opt %}
                    if (((1 << {{lh.optIdx(arg)}}) & opt_flags) != 0)
                        f2c::hier_smem_add({{hier_smem_slot(arg, "hier_colouring")}}, op2_local{{arg.id}}, {{dat_dim_w(lh.dat(arg))}});
        {% else %}
                    f2c::hier_smem_add({{hier_smem_slot(arg, "hier_colouring")}}, op2_local{{arg.id}}, {{dat_dim_w(lh.dat(arg))}});
        {% endif %}
    {% endfor %}
                }

                __syncthreads();
            }
        }
{%- endmacro %}

{#- The serialised shape: the kernel itself runs one thread colour at a time
    against the staged slots.  OP_HIER_COLOURING_HOIST lets each element's
    address arithmetic hoist out of the passes, and PRELOAD resolves its
    staged slots before the passes. -#}
{%- macro hier_colour_serial_passes(jit) %}
        for (int op2_base = op2_source_begin; op2_base < op2_source_end;
             op2_base += blockDim.x) {
            {{hier_colour_slice()|indent(12)}}
    {% for arg in group_args["hier_colouring"] %}
            const int op2_slot{{loop.index0}} = (op2_variants & f2c::hier_variant_preload){{" && (op2_variants & f2c::hier_variant_stage_reads)" if arg in args_hier_reads}} && op2_n >= 0
                ? (int)f2c::hier_smem_stage_slot(stage_words[{{loop.index0}} * stride + op2_n]) : 0;
    {% endfor %}
            for (int op2_pass = op2_first_pass; op2_pass < op2_end_pass; ++op2_pass) {
                if (op2_colour == op2_pass) {
                    // Opaque unless hoisting is asked for, so this element's
                    // address arithmetic is not kept live through every pass.
                    const int n = (op2_variants & f2c::hier_variant_hoist) ? op2_n : f2c::opaque(op2_n);
                    {{kernel_call(jit, "hier_colouring", false, true)|indent(20)}}
                }

                __syncthreads();
            }
        }
{%- endmacro %}

{#- Apply a chunk's elements to their staged slots, in whichever shape this
    loop and the run's variants allow. -#}
{%- macro hier_colour_passes(jit) %}
        const int op2_colours = chunk_thread_colours[chunk];
    {% if hier_colouring_parallel %}
        const bool op2_serial = (op2_variants & f2c::hier_variant_serial) != 0
        {% for arg in args_hier_atomics if lh.dat(arg).dim is none %}
            || {{dat_dim_w(lh.dat(arg))}} > f2c::hier_max_local_dim
        {% endfor %}
            ;
        if (!op2_serial) {
{{hier_colour_parallel_passes(jit)}}
        } else {
{{hier_colour_serial_passes(jit)}}
        }
    {% else %}
{{hier_colour_serial_passes(jit)}}
    {% endif %}
{%- endmacro %}

{#- Stage a chunk's grouped targets in shared memory, apply its elements to
    them, then flush each target once.  hier_atomics clears its slots and
    accumulates into them with shared atomics, seeding only owners its section
    keeps exclusive, and read-only slots.  hier_colouring seeds every slot,
    since a launch's chunks share no target, and applies its elements by
    thread colour. -#}
{%- macro hier_smem_body(strategy, jit = false) %}
    {% set dats = group_dats[strategy] %}
    {% set grouped = group_args[strategy] %}
    extern __shared__ char op2_stage_smem[];

    {% for dat_id in dats %}
    const bool op2_stage{{loop.index0}}_active = {{hier_smem_group_active(strategy, dat_id)}};
    {% endfor %}

    {% if strategy == "hier_colouring" %}
    // Physical blocks grid-stride over this launch's chunks, which share no
    // target of any group.
    for (int op2_i = chunk_begin + blockIdx.x; op2_i < chunk_end;
         op2_i += gridDim.x) {
        const int chunk = chunk_order[op2_i];
    {% else %}
    // Physical blocks grid-stride over this section's plan chunks; the plan
    // guarantees no chunk spans a section boundary.
    for (int chunk = chunk_begin + blockIdx.x; chunk < chunk_end;
         chunk += gridDim.x) {
    {% endif %}
        const int op2_source_begin = source_offsets[chunk];
        const int op2_source_end = source_offsets[chunk + 1];
        [[maybe_unused]] const int op2_chunk_length = op2_source_end - op2_source_begin;
        const int *op2_chunk_counts =

struct op2_k_{{lh.name}}{{variant}}_bindings {
    static constexpr std::array strategies{
{% for strategy in strategies %}
        op::f2c::Strategy::{{strategy}},
{% endfor %}
    };

    template<op::f2c::Strategy S>
    auto make_arguments(op::f2c::LaunchContext& launch, op_arg *args) const {
{% if lh.args|opt|length > 0 %}
        launch.opt_flags = 0;
    {% for arg in lh.args|opt %}
        if (args[{{arg.id}}].opt)
            launch.opt_flags |= 1 << {{lh.optIdx(arg)}};
    {% endfor %}
{% endif %}

{% for strategy in strategies %}
        {{"if" if loop.first else "} else if"}} constexpr (S == op::f2c::Strategy::{{strategy}}) {
            auto offline = std::array{
{{kernel_arguments(strategy)}}
            };
            auto jit = std::array{
{{kernel_arguments(strategy, jit=true)}}
            };
            return op::f2c::KernelArguments{offline, jit};
{% endfor %}
        }
    }

    void init_globals(const op::f2c::GlobalInitContext& context,
                      op_arg *args) const {
{% for arg in args_gbl_per_thread|select2("min", "max", "work") %}
        static {{arg.typ.c()}} *gbl{{arg.id}}_ref_d = nullptr;
        static int gbl{{arg.id}}_ref_capacity = 0;
        const int gbl{{arg.id}}_ref_dim =
            {{arg.dim if arg.dim is not none else "args[%s].dim" % arg.id}};

    {% if arg is opt %}
        if (args[{{arg.id}}].opt == 1) {
    {% endif %}
        if (gbl{{arg.id}}_ref_capacity < gbl{{arg.id}}_ref_dim) {
            if (gbl{{arg.id}}_ref_d != nullptr)
                CUDA_SAFE_CALL({{api_prefix}}Free(gbl{{arg.id}}_ref_d));
            CUDA_SAFE_CALL({{api_prefix}}Malloc(&gbl{{arg.id}}_ref_d,
                gbl{{arg.id}}_ref_dim * sizeof({{arg.typ.c()}})));
            gbl{{arg.id}}_ref_capacity = gbl{{arg.id}}_ref_dim;
        }

        CUDA_SAFE_CALL({{api_prefix}}MemcpyAsync(
            gbl{{arg.id}}_ref_d, args[{{arg.id}}].data,
            gbl{{arg.id}}_ref_dim * sizeof({{arg.typ.c()}}),
            {{api_prefix}}MemcpyHostToDevice, 0));
    {% if arg is opt %}
        }
    {% endif %}
{% endfor %}
{% if args_gbl_per_thread|length > 0 %}
        {{init_gbls()|indent(8)}}
{% else %}
        (void)context;
        (void)args;
{% endif %}
    }
};

static op::f2c::LoopDescription
op2_k_{{lh.name}}{{variant}}_loop() {
{% if lh is direct %}
    return op::f2c::LoopDescription::direct(
        {{"true" if config.gbl_inc_atomic else "false"}});
{% else %}
    static constexpr std::array<int, {{lh.args|length}}> indirect_dats = {
    {%- for arg in lh.args -%}
        {{lh.dats|indirect(lh)|index(lh.dat(arg)) if arg is dat and arg is indirect else "-1"}}
        {{-", " if not loop.last}}
    {%- endfor -%}
    };
#ifdef OP_PART_SIZE_{{kernel_idx}}
    constexpr int part_size = OP_PART_SIZE_{{kernel_idx}};
#else
    constexpr int part_size = -1;
#endif
    return op::f2c::LoopDescription::indirect(
        indirect_dats, part_size,
        {{"true" if config.gbl_inc_atomic else "false"}});
{% endif %}
}

static bool op2_k_{{lh.name}}{{variant}}_register_info(
    op::f2c::KernelInfo& info) {
    namespace kernel = op2_m_{{lh.name}}{{variant}};

{% if lh.dats|direct(lh)|soa|length > 0 %}
    info.add_dat_stride_param("op2_stride_direct_d",
        &kernel::op2_stride_direct,
        {{lh.args|direct(lh)|soa(lh)|first|attr("id")}},
        &kernel::op2_stride_direct_d);
{% endif %}
{% for dat in lh.dats|indirect(lh)|soa %}
    info.add_dat_stride_param("op2_stride_dat{{dat.id}}_d",
        &kernel::op2_stride_dat{{dat.id}}, {{dat.arg_id}},
        &kernel::op2_stride_dat{{dat.id}}_d);
{% endfor %}
{% for const in lh.consts if lh.const_types.get("op2_const_" + const + "_d") is not fcharacter %}
    {% if lh.const_types.get("op2_const_" + const + "_d") is farray %}
    info.add_param("op2_const_{{const}}_d", {{"op2_const_" if lang.user_consts_module is none}}{{const}}, sizeof(op2_const_{{const}}_d) / sizeof({{"op2_const_" if lang.user_consts_module is none}}{{const}}[0]), op2_const_{{const}}_d, &op2_const_{{const}}_hash);
    {% else %}
    info.add_param("op2_const_{{const}}_d", &{{"op2_const_" if lang.user_consts_module is none}}{{const}}, &op2_const_{{const}}_d, &op2_const_{{const}}_hash);
    {% endif %}
{% endfor %}
{% for arg in lh.args|gbl|read|scalar %}
    info.add_scalar_arg_param("op2_gbl{{arg.id}}_d",
        &kernel::op2_gbl{{arg.id}}, {{arg.id}});
{% endfor %}
{% if "hier_atomics" in strategies or "hier_colouring" in strategies %}
#ifdef OP_PART_SIZE_{{kernel_idx}}
    constexpr int chunk_size = OP_PART_SIZE_{{kernel_idx}};
#else
    constexpr int chunk_size = -1;
#endif
{% endif %}
{% for strategy in strategies %}
    {% if strategy in ["hier_atomics", "hier_colouring"] %}
    static constexpr std::array {{strategy}}_args = {
        {% for arg in group_args[strategy] %}
        op::f2c::HierArgDescriptor{ {{arg.id}},
            {{group_dats[strategy]|index(arg.dat_id)}} },
        {% endfor %}
    };
    static constexpr std::array {{strategy}}_dats = {
        {% for dat_id in group_dats[strategy] %}
        {{hier_smem_scalar_type(lh.dat(dat_id))}},
        {% endfor %}
    };
    {% endif %}
    info.register_variant(
        op::f2c::Strategy::{{strategy}},
        "op2_k_{{lh.name}}{{variant}}_{{strategy}}_wrapper",
        (void *)op2_k_{{lh.name}}{{variant}}_{{strategy}}_wrapper,
        op2_k_{{lh.name}}{{variant}}_{{strategy}}_src{{"," if strategy in ["hier_atomics", "hier_colouring"] else ");"}}
    {% if strategy in ["hier_atomics", "hier_colouring"] %}
        op::f2c::HierArgGroups{
            {{strategy}}_args, {{strategy}}_dats, chunk_size});
    {% endif %}
{% endfor %}
    return true;
}

static op::f2c::KernelInfo& op2_k_{{lh.name}}{{variant}}_info() {
    static op::f2c::KernelInfo info(
        "{{lh.name}}", "c_CUDA", "{{variant_str()}}",
        op2_k_{{lh.name}}{{variant}}_loop());
    static const bool registered =
        op2_k_{{lh.name}}{{variant}}_register_info(info);
    (void)registered;
    return info;
}


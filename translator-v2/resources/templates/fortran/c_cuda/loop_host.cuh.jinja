{%- endif -%}

{%- macro gbl_dim_w(arg) -%}
    {%- if arg.dim is not none -%}
{{arg.dim}}
    {%- else -%}
arg{{arg.id}}_dim
    {%- endif -%}
{%- endmacro -%}

{%- macro dat_dim_w(dat) -%}
    {%- if dat.dim is not none -%}
{{dat.dim}}
    {%- else -%}
dat{{dat.id}}_dim
    {%- endif -%}
{%- endmacro -%}

{%- macro map_idx(arg) -%}
    {%- if arg is runtime_map_idx %}
arg{{arg.id}}_idx
    {%- else -%}
{{arg.map_idx - 1}}
    {%- endif -%}
{%- endmacro -%}

{% macro map_lookup(arg) -%}
map{{arg.map_id}}[{{map_idx(arg)}} * stride + n]
{%- endmacro %}

{%- macro arg_to_pointer_cuda(arg, jit = false) %}
    {%- if arg is idx and arg is indirect -%}
idx{{arg.id}}
    {%- elif arg is idx -%}
idx
    {%- elif arg is opt and arg is scalar(lh) -%}
        {%- if arg is gbl or arg is info %}
            {%- set zero_type = arg.typ.c() -%}
        {%- else -%}
            {%- set zero_type = lh.dat(arg).typ.c() -%}
        {%- endif -%}
(1 << {{lh.optIdx(arg)}}) & opt_flags ? {{arg_to_pointer2(arg, jit)}} : zero_{{zero_type}}
    {%- else -%}
{{arg_to_pointer2(arg, jit)}}
    {%- endif -%}
{%- endmacro -%}

{%- macro arg_to_pointer2(arg, jit) -%}
    {%- if jit and arg is gbl and arg is read and arg is scalar -%}
op2_gbl{{arg.id}}_d
    {%- elif arg is gbl and arg is read and arg is scalar -%}
gbl{{arg.id}}
    {%- elif arg is scalar(lh) -%}
{{arg_to_pointer3(arg)}}.data[0]
    {%- else -%}
{{arg_to_pointer3(arg)}}
    {%- endif -%}
{%- endmacro -%}

{%- macro arg_to_pointer3(arg) -%}
    {%- if arg is info -%}
f2c::Ptr{info{{arg.id}} + thread_id, stride_gbl}
    {%- elif arg in args_gbl_per_thread -%}
f2c::Ptr{gbl{{arg.id}} + thread_id, stride_gbl}
    {%- elif arg is gbl -%}
f2c::Ptr{gbl{{arg.id}}}
    {%- else -%}
{{arg_to_pointer4(arg)}}
    {%- endif -%}
{%- endmacro -%}

{%- macro arg_to_pointer4(arg) -%}
    {%- if arg is direct and lh.dat(arg) is soa -%}
f2c::Ptr{dat{{arg.dat_id}} + n, op2_stride_direct_d}
    {%- elif arg is direct -%}
f2c::Ptr{dat{{arg.dat_id}} + n * {{dat_dim_w(lh.dat(arg))}}}
    {%- elif lh.dat(arg) is soa -%}
f2c::Ptr{dat{{arg.dat_id}} + {{map_lookup(arg)}}, op2_stride_dat{{arg.dat_id}}_d}
    {%- else -%}
f2c::Ptr{dat{{arg.dat_id}} + {{map_lookup(arg)}} * {{dat_dim_w(lh.dat(arg))}}}
    {%- endif -%}
{%- endmacro -%}

{%- macro init_gbls() -%}
op2_k_{{lh.name}}{{variant}}_init_gbls<<<context.max_blocks, context.block_size>>>(
    {% for arg in args_gbl_per_thread %}
    ({{arg.typ.c()}} *)args[{{arg.id}}].data_d,
    {% endfor %}
    {% for arg in args_gbl_per_thread|select2("min", "max", "work") %}
    gbl{{arg.id}}_ref_d,
    {% endfor %}
    {% for arg in args_gbl_per_thread if arg.dim is none %}
    args[{{arg.id}}].dim,
    {% endfor %}
    {% for arg in args_gbl_per_thread if arg is opt %}
    args[{{arg.id}}].opt,
    {% endfor %}
    context.global_stride
);

CUDA_SAFE_CALL({{api_prefix}}PeekAtLastError());
{%- endmacro -%}

namespace op2_m_{{lh.name}}{{variant}} {

{% if lh.dats|direct(lh)|soa|length > 0 %}
int op2_stride_direct;
__constant__ int op2_stride_direct_d;
{% endif %}

{% for dat in lh.dats|indirect(lh)|soa %}
int op2_stride_dat{{dat.id}};
__constant__ int op2_stride_dat{{dat.id}}_d;
{% endfor %}

{% for arg in lh.args|gbl|read|scalar %}
{{arg.typ.c()}} op2_gbl{{arg.id}};
{% endfor %}

{{kernel_func}}}

{% macro kernel_wrapper(jit = false) %}
extern "C" __global__ {{"__launch_bounds__(128)" if config.hip}}
void op2_k_{{lh.name}}{{variant}}_wrapper(
    {% for dat in lh.dats %}
    {{"const " if dat is read_in(lh)}}{{dat.typ.c()}} *__restrict dat{{dat.id}},
    {% endfor %}
    {% for map in lh.maps %}
    const int *__restrict map{{map.id}},
    {% endfor %}
    {% for arg in lh.args|gbl if not (arg is read and arg is scalar) %}
    {{"const " if arg is read}}{{arg.typ.c()}} *__restrict gbl{{arg.id}},
    {% endfor %}
    {% for arg in lh.args|gbl|read|scalar if not jit %}
    const {{arg.typ.c()}} gbl{{arg.id}},
    {% endfor %}
    {% for arg in lh.args|info %}
    {{arg.typ.c()}} *__restrict info{{arg.id}},
    {% endfor %}
    {% for dat in lh.dats if dat.dim is none and dat is not soa %}
    const int dat{{dat.id}}_dim,
    {% endfor %}
    {% for arg in lh.args|runtime_map_idx %}
    const int arg{{arg.id}}_idx,
    {% endfor %}
    {% if lh is indirect and config.color2 %}
    const int *__restrict col_reord,
    {% endif %}
    {% if args_gbl_per_thread|length > 0 %}
    const int stride_gbl,
    {% endif %}
    {% if lh.args|opt|length > 0 %}
    const unsigned opt_flags,
    {% endif %}
    const int start,
    const int end,
    const int stride
) {
    using namespace op2_m_{{lh.name}}{{variant}};
    int thread_id = threadIdx.x + blockIdx.x * blockDim.x;

    [[maybe_unused]] int zero_int = 0;
    [[maybe_unused]] bool zero_bool = 0;
    [[maybe_unused]] float zero_float = 0;
    [[maybe_unused]] double zero_double = 0;

    for (int i = thread_id + start; i < end; i += blockDim.x * gridDim.x) {
    {% if lh is indirect and config.color2 %}
        int n = col_reord[i];
    {% else %}
        int n = i;
    {% endif %}

    {% if lh.args|idx|direct|length > 0 %}
        int idx = n + 1;
    {% endif %}

    {% for arg in lh.args|idx|indirect %}
        int idx{{arg.id}} = {{map_lookup(arg)}} + 1;
    {% endfor %}

        {{lh.kernel}}(
    {% for arg in lh.args %}
            {{arg_to_pointer_cuda(arg, jit)}}{{"," if not loop.last}}
    {% endfor %}
        );
    }
}
{% endmacro %}

{{kernel_wrapper()}}

const char op2_k_{{lh.name}}{{variant}}_src[] = R"_op2_k(
namespace op2_m_{{lh.name}}{{variant}} {

using int64_t = long long int;

{{kernel_func}}}

{{kernel_wrapper(jit=true)}}
)_op2_k";

{% if args_gbl_per_thread|length > 0 %}
__global__
static void op2_k_{{lh.name}}{{variant}}_init_gbls(
{% for arg in args_gbl_per_thread %}
    {{arg.typ.c()}} *gbl{{arg.id}},
{% endfor %}
{% for arg in args_gbl_per_thread|select2("min", "max", "work") %}
    {{arg.typ.c()}} *gbl{{arg.id}}_ref,
{% endfor %}
{% for arg in args_gbl_per_thread if arg.dim is none %}
    int arg{{arg.id}}_dim,
{% endfor %}
{% for arg in args_gbl_per_thread if arg is opt %}
    int arg{{arg.id}}_opt,
{% endfor %}
    int stride
) {
    namespace kernel = op2_m_{{lh.name}}{{variant}};

    int thread_id = threadIdx.x + blockIdx.x * blockDim.x;

{% for arg in args_gbl_per_thread %}
    {% if arg is opt %}
    if (arg{{arg.id}}_opt == 1) {
    {% endif %}
    for (int d = 0; d < {{gbl_dim_w(arg)}}; ++d) {
        gbl{{arg.id}}[thread_id + d * stride] = {% if arg is inc -%}
            0;
    {%- else -%}
            gbl{{arg.id}}_ref[d];
    {%- endif +%}
    }
    {% if arg is opt %}
    }
    {% endif %}
{% endfor %}
}
{% endif %}

struct op2_k_{{lh.name}}{{variant}}_bindings {
    template<op::f2c::KernelVariant Variant>
    auto make_arguments(op::f2c::LaunchContext& launch, op_arg *args) const {
{% if lh.args|opt|length > 0 %}
        launch.opt_flags = 0;
    {% for arg in lh.args|opt %}
        if (args[{{arg.id}}].opt)
            launch.opt_flags |= 1 << {{lh.optIdx(arg)}};
    {% endfor %}
{% endif %}

        auto offline = std::array{
    {% for dat in lh.dats %}
            (void *)&args[{{dat.arg_id}}].data_d,
    {% endfor %}
    {% for map in lh.maps %}
            (void *)&args[{{map.arg_id}}].map_data_d,
    {% endfor %}
    {% for arg in lh.args|gbl if not (arg is read and arg is scalar) %}
            (void *)&args[{{arg.id}}].data_d,
    {% endfor %}
    {% for arg in lh.args|gbl|read|scalar %}
            (void *)args[{{arg.id}}].data,
    {% endfor %}
    {% for arg in lh.args|info %}
            (void *)&args[{{arg.id}}].data_d,
    {% endfor %}
    {% for dat in lh.dats if dat.dim is none and dat is not soa %}
            (void *)&args[{{dat.arg_id}}].dim,
    {% endfor %}
    {% for arg in lh.args|runtime_map_idx %}
            (void *)&args[{{arg.id}}].idx,
    {% endfor %}
    {% if lh is indirect and config.color2 %}
            (void *)&launch.color_reorder,
    {% endif %}
    {% if args_gbl_per_thread|length > 0 %}
            (void *)&launch.global_stride,
    {% endif %}
    {% if lh.args|opt|length > 0 %}
            (void *)&launch.opt_flags,
    {% endif %}
            (void *)&launch.start,
            (void *)&launch.end,
            (void *)&launch.set_stride
        };

        auto jit = std::array{
    {% for dat in lh.dats %}
            (void *)&args[{{dat.arg_id}}].data_d,
    {% endfor %}
    {% for map in lh.maps %}
            (void *)&args[{{map.arg_id}}].map_data_d,
    {% endfor %}
    {% for arg in lh.args|gbl if not (arg is read and arg is scalar) %}
            (void *)&args[{{arg.id}}].data_d,
    {% endfor %}
    {% for arg in lh.args|info %}
            (void *)&args[{{arg.id}}].data_d,
    {% endfor %}
    {% for dat in lh.dats if dat.dim is none and dat is not soa %}
            (void *)&args[{{dat.arg_id}}].dim,
    {% endfor %}
    {% for arg in lh.args|runtime_map_idx %}
            (void *)&args[{{arg.id}}].idx,
    {% endfor %}
    {% if lh is indirect and config.color2 %}
            (void *)&launch.color_reorder,
    {% endif %}
    {% if args_gbl_per_thread|length > 0 %}
            (void *)&launch.global_stride,
    {% endif %}
    {% if lh.args|opt|length > 0 %}
            (void *)&launch.opt_flags,
    {% endif %}
            (void *)&launch.start,
            (void *)&launch.end,
            (void *)&launch.set_stride
        };

        return op::f2c::KernelArguments{offline, jit};
    }

    void init_globals(const op::f2c::GlobalInitContext& context,
                      op_arg *args) const {
{% for arg in args_gbl_per_thread|select2("min", "max", "work") %}
        static {{arg.typ.c()}} *gbl{{arg.id}}_ref_d = nullptr;

        if (gbl{{arg.id}}_ref_d == nullptr{{" && args[%s].opt == 1" % arg.id if arg is opt}}) {
            CUDA_SAFE_CALL({{api_prefix}}Malloc(&gbl{{arg.id}}_ref_d,
                {{arg.dim if arg.dim is not none else "args[%s].dim" % arg.id}} * sizeof({{arg.typ.c()}})));
        }

        {{"if (args[%s].opt == 1) " % arg.id if arg is opt-}}
            CUDA_SAFE_CALL({{api_prefix}}MemcpyAsync(
                gbl{{arg.id}}_ref_d, args[{{arg.id}}].data,
                {{arg.dim if arg.dim is not none else "args[%s].dim" % arg.id}} * sizeof({{arg.typ.c()}}),
                {{api_prefix}}MemcpyHostToDevice, 0));
{% endfor %}
{% if args_gbl_per_thread|length > 0 %}
        {{init_gbls()|indent(8)}}
{% else %}
        (void)context;
        (void)args;
{% endif %}
    }
};

static op::f2c::ExecutionPolicy
op2_k_{{lh.name}}{{variant}}_execution_policy() {
{% if lh is direct %}
    return op::f2c::ExecutionPolicy::direct();
{% elif config.atomics %}
    return op::f2c::ExecutionPolicy::atomics(
        {{"true" if config.gbl_inc_atomic else "false"}});
{% else %}
    static constexpr std::array<int, {{lh.args|length}}> indirect_dats = {
    {%- for arg in lh.args -%}
        {{lh.dats|indirect(lh)|index(lh.dat(arg)) if arg is dat and arg is indirect else "-1"}}
        {{-", " if not loop.last}}
    {%- endfor -%}
    };
#ifdef OP_PART_SIZE_{{kernel_idx}}
    constexpr int part_size = OP_PART_SIZE_{{kernel_idx}};
#else
    constexpr int part_size = -1;
#endif
    return op::f2c::ExecutionPolicy::color2(indirect_dats, part_size);
{% endif %}
}

static bool op2_k_{{lh.name}}{{variant}}_register_info(
    op::f2c::KernelInfo& info) {
    namespace kernel = op2_m_{{lh.name}}{{variant}};

{% if lh.dats|direct(lh)|soa|length > 0 %}
    info.add_dat_stride_param("op2_stride_direct_d",
        &kernel::op2_stride_direct,
        {{lh.args|direct(lh)|soa(lh)|first|attr("id")}},
        &kernel::op2_stride_direct_d);
{% endif %}
{% for dat in lh.dats|indirect(lh)|soa %}
    info.add_dat_stride_param("op2_stride_dat{{dat.id}}_d",
        &kernel::op2_stride_dat{{dat.id}}, {{dat.arg_id}},
        &kernel::op2_stride_dat{{dat.id}}_d);
{% endfor %}
{% for const in lh.consts if lh.const_types.get("op2_const_" + const + "_d") is not fcharacter %}
    {% if lh.const_types.get("op2_const_" + const + "_d") is farray %}
    info.add_param("op2_const_{{const}}_d", {{"op2_const_" if lang.user_consts_module is none}}{{const}}, sizeof(op2_const_{{const}}_d) / sizeof({{"op2_const_" if lang.user_consts_module is none}}{{const}}[0]), op2_const_{{const}}_d, &op2_const_{{const}}_hash);
    {% else %}
    info.add_param("op2_const_{{const}}_d", &{{"op2_const_" if lang.user_consts_module is none}}{{const}}, &op2_const_{{const}}_d, &op2_const_{{const}}_hash);
    {% endif %}
{% endfor %}
{% for arg in lh.args|gbl|read|scalar %}
    info.add_scalar_arg_param("op2_gbl{{arg.id}}_d",
        &kernel::op2_gbl{{arg.id}}, {{arg.id}});
{% endfor %}
    return true;
}

static op::f2c::KernelInfo& op2_k_{{lh.name}}{{variant}}_info() {
    static op::f2c::KernelInfo info(
        "{{lh.name}}", "c_CUDA", "{{variant_str()}}",
        op2_k_{{lh.name}}{{variant}}_execution_policy(),
        "op2_k_{{lh.name}}{{variant}}_wrapper",
        (void *)op2_k_{{lh.name}}{{variant}}_wrapper,
        op2_k_{{lh.name}}{{variant}}_src);
    static const bool registered =
        op2_k_{{lh.name}}{{variant}}_register_info(info);
    (void)registered;
    return info;
}

extern "C" void op2_k_{{lh.name}}{{variant}}_c(
    op_set set,
{% for arg in lh.args %}
    op_arg arg{{arg.id}}{{"," if not loop.last}}
{% endfor %}
) {
    op_arg args[] = {
{% for arg in lh.args %}
        arg{{arg.id}}{{"," if not loop.last}}
{% endfor %}
    };

    op2_k_{{lh.name}}{{variant}}_info().invoke(
        set, args, {{lh.args|length}},
        op2_k_{{lh.name}}{{variant}}_bindings{});
}

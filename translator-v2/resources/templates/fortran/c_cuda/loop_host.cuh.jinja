    {{init_gbls()|indent(4)}}
}
{% endif %}

{% macro kernel_arguments(strategy, jit = false) %}
    {% for dat in lh.dats %}
        (void *)&args[{{dat.arg_id}}].data_d,
    {% endfor %}
    {% for map in lh.maps %}
        (void *)&args[{{map.arg_id}}].map_data_d,
    {% endfor %}
    {% for arg in lh.args|gbl if not (arg is read and arg is scalar) %}
        (void *)&args[{{arg.id}}].data_d,
    {% endfor %}
    {% for arg in lh.args|gbl|read|scalar if not jit %}
        (void *)args[{{arg.id}}].data,
    {% endfor %}
    {% for arg in lh.args|info %}
        (void *)&args[{{arg.id}}].data_d,
    {% endfor %}
    {% for dat in lh.dats if dat.dim is none and dat is not soa and not jit %}
        (void *)&args[{{dat.arg_id}}].dim,
    {% endfor %}
    {% for arg in lh.args|runtime_map_idx %}
        (void *)&args[{{arg.id}}].idx,
    {% endfor %}
    {% if strategy == "colouring" %}
        (void *)&launch.colour_order,
    {% endif %}
    {% if args_gbl_per_thread|length > 0 %}
        (void *)&launch.global_stride,
    {% endif %}
    {% if lh.args|opt|length > 0 %}
        (void *)&launch.opt_flags,
    {% endif %}
        (void *)&launch.start,
        (void *)&launch.end,
        (void *)&launch.set_stride,
    {% for ctype, name, expr in chunk_params.get(strategy, []) %}
        (void *)&{{expr}},
    {% endfor %}
{%- endmacro %}

{#- Each strategy's kernel arguments, offline and JIT, from the launch. -#}
{% for strategy in strategies %}
static void op2_k_{{lh.name}}{{variant}}_bind_{{strategy}}(
    op::gpu::LaunchContext& launch, op_arg *args,
    std::vector<void *>& offline, std::vector<void *>& jit) {
{% if lh.args|opt|length > 0 %}
    launch.opt_flags = 0;
    {% for arg in lh.args|opt %}
    if (args[{{arg.id}}].opt)
        launch.opt_flags |= 1 << {{lh.optIdx(arg)}};
    {% endfor %}
{% else %}
    (void)args;
{% endif %}

    {% if strategy in offline_strategies %}
    offline = {
{{kernel_arguments(strategy)}}    };
    {% else %}
    offline = {};
    {% endif %}
    jit = {
{{kernel_arguments(strategy, jit=true)}}    };
}

{% endfor %}
static bool op2_k_{{lh.name}}{{variant}}_register(op::gpu::Loop& loop) {
    namespace kernel = op2_m_{{lh.name}}{{variant}};
    auto& jit = loop.jit();

{% if lh.dats|direct(lh)|soa|length > 0 %}
    jit.add_dat_stride_param("op2_stride_direct_d",
        &kernel::op2_stride_direct,
        {{lh.args|direct(lh)|soa(lh)|first|attr("id")}},
        &kernel::op2_stride_direct_d);
{% endif %}
{% for dat in lh.dats|indirect(lh)|soa %}
    jit.add_dat_stride_param("op2_stride_dat{{dat.id}}_d",
        &kernel::op2_stride_dat{{dat.id}}, {{dat.arg_id}},
        &kernel::op2_stride_dat{{dat.id}}_d);
{% endfor %}
{% for const in lh.consts if lh.const_types.get("op2_const_" + const + "_d") is not fcharacter %}
    {% if lh.const_types.get("op2_const_" + const + "_d") is farray %}
    jit.add_param("op2_const_{{const}}_d", {{"op2_const_" if lang.user_consts_module is none}}{{const}}, sizeof(op2_const_{{const}}_d) / sizeof({{"op2_const_" if lang.user_consts_module is none}}{{const}}[0]), op2_const_{{const}}_d, &op2_const_{{const}}_hash);
    {% else %}
    jit.add_param("op2_const_{{const}}_d", &{{"op2_const_" if lang.user_consts_module is none}}{{const}}, &op2_const_{{const}}_d, &op2_const_{{const}}_hash);
    {% endif %}
{% endfor %}
{% for dat in lh.dats if dat.dim is none %}
    jit.add_dat_dim_param("op2_dim_dat{{dat.id}}_d",
        &kernel::op2_dim_dat{{dat.id}}, {{dat.arg_id}});
{% endfor %}
{% for arg in lh.args|gbl|read|scalar %}
    jit.add_scalar_arg_param("op2_gbl{{arg.id}}_d",
        &kernel::op2_gbl{{arg.id}}, {{arg.id}});
{% endfor %}
    jit.add_block_size_param("op2_block_size_d", &kernel::op2_block_size);
{% if strategies|select("in", chunk_strategies)|list %}
    jit.add_unstaged_singles_param("op2_unstaged_singles_d", &kernel::op2_unstaged_singles);
    jit.add_wavefront_param("op2_wavefront_d", &kernel::op2_wavefront);
{% endif %}
{% for strategy in strategies %}
    {% if strategy in chunk_strategies %}
    static constexpr std::array<op::plan::ArgGroup, {{groups[strategy].args|length}}> {{strategy}}_groups = {{"{{"}}
        {% for arg in groups[strategy].args %}
        op::plan::ArgGroup{ {{arg.id}}, {{groups[strategy].group(arg)}} },
        {% endfor %}
    {{"}}"}};
    {% endif %}
    loop.add<op::gpu::{{"ChunkAtomics" if strategy == "chunk_atomics" else "ChunkColouring" if strategy == "chunk_colouring" else "Colouring" if strategy == "colouring" else "Simple"}}>(
        "{{strategy}}", op::loop::Default::{{"enabled" if strategy in default_strategies else "disabled"}},
        op::gpu::KernelSource{
            "op2_k_{{lh.name}}{{variant}}_{{strategy}}_wrapper",
            {{"(const void *)op2_k_%s%s_%s_wrapper" % (lh.name, variant, strategy) if strategy in offline_strategies else "nullptr"}},
            op2_k_{{lh.name}}{{variant}}_{{strategy}}_src},
        &op2_k_{{lh.name}}{{variant}}_bind_{{strategy}}{{"," if strategy in chunk_strategies else ");"}}
    {% if strategy in chunk_strategies %}
        op::plan::ArgGroups{ {{strategy}}_groups, {{groups[strategy].dats|length}} });
    {% endif %}
{% endfor %}
    return true;
}

static op::gpu::Loop& op2_k_{{lh.name}}{{variant}}_loop() {
    static op::gpu::Loop loop(
        "{{lh.name}}", "c_CUDA", "{{variant_str()}}",
        op::gpu::LoopDescription{ {{"true" if lh is direct else "false"}},
                                  {{"true" if config.gbl_inc_atomic else "false"}} },
        OP_F2C_JIT_HEADERS,
        {{"&op2_k_%s%s_init_globals" % (lh.name, variant) if args_gbl_per_thread|length > 0 else "nullptr"}});
    static const bool registered = op2_k_{{lh.name}}{{variant}}_register(loop);
    (void)registered;
    return loop;
}

extern "C" void op2_k_{{lh.name}}{{variant}}_c(
    op_set set,
{% for arg in lh.args %}
    op_arg arg{{arg.id}}{{"," if not loop.last}}
{% endfor %}
) {
    op_arg args[] = {
{% for arg in lh.args %}
        arg{{arg.id}}{{"," if not loop.last}}
{% endfor %}
    };

    op2_k_{{lh.name}}{{variant}}_loop().invoke(set, args, {{lh.args|length}});
}

{% endfor %}
}
{% endif %}

extern "C" void op2_k_{{lh.name}}{{variant}}_c(
    op_set set,
{% for arg in lh.args %}
    op_arg arg{{arg.id}}{{"," if not loop.last}}
{% endfor %}
) {
    namespace kernel = op2_m_{{lh.name}}{{variant}};

    int n_args = {{lh.args|length}};
    op_arg args[{{lh.args|length}}];

    op_profile_enter_kernel("{{lh.name}}", "c_CUDA", "{{variant_str()}}");
    op_profile_enter("Init");

    op_profile_enter("Kernel Info Setup");

    static bool first_invocation = true;
    {% if use_smem_atomics %}
    static bool first_invocation_smem = true;
    {% endif %}
    static op::f2c::KernelInfo info("op2_k_{{lh.name}}{{variant}}_wrapper",
                                    (void *)op2_k_{{lh.name}}{{variant}}_wrapper,
                                    op2_k_{{lh.name}}{{variant}}_src);

    if (first_invocation) {
{% if lh.dats|direct(lh)|soa|length > 0 %}
        info.add_param("op2_stride_direct_d", &kernel::op2_stride_direct, &kernel::op2_stride_direct_d);
{% endif %}
{% for dat in lh.dats|indirect(lh)|soa %}
        info.add_param("op2_stride_dat{{dat.id}}_d", &kernel::op2_stride_dat{{dat.id}}, &kernel::op2_stride_dat{{dat.id}}_d);
{% endfor %}
{% for const in lh.consts if lh.const_types.get("op2_const_" + const + "_d") is not fcharacter %}
    {% if lh.const_types.get("op2_const_" + const + "_d") is farray %}
        info.add_param("op2_const_{{const}}_d", {{"op2_const_" if lang.user_consts_module is none}}{{const}}, sizeof(op2_const_{{const}}_d) / sizeof({{"op2_const_" if lang.user_consts_module is none}}{{const}}[0]), op2_const_{{const}}_d, &op2_const_{{const}}_hash);
    {% else %}
        info.add_param("op2_const_{{const}}_d", &{{"op2_const_" if lang.user_consts_module is none}}{{const}}, &op2_const_{{const}}_d, &op2_const_{{const}}_hash);
    {% endif %}
{% endfor %}
{% for arg in lh.args|gbl|read|scalar %}
        info.add_param("op2_gbl{{arg.id}}_d", &kernel::op2_gbl{{arg.id}});
{% endfor %}

        first_invocation = false;
    }

{% for arg in lh.args %}
    args[{{loop.index0}}] = arg{{arg.id}};
{% endfor %}

    op_profile_next("MPI Exchanges");
    int n_exec = op_mpi_halo_exchanges_grouped(set, n_args, args, 2);

    if (n_exec == 0) {
        op_profile_exit();
        op_profile_exit();

        op_mpi_wait_all_grouped(n_args, args, 2);

{% for arg in lh.args|gbl|reduction %}
        op_mpi_reduce(&arg{{arg.id}}, ({{arg.typ.c()}} *)arg{{arg.id}}.data);
{% endfor %}

        op_mpi_set_dirtybit_cuda(n_args, args);
        op_profile_exit();
        return;
    }

    setGblIncAtomic({{"true" if config.gbl_inc_atomic else "false"}});

{% for arg in lh.args|gbl|read|scalar %}
    kernel::op2_gbl{{arg.id}} = (({{arg.typ.c()}} *)arg{{arg.id}}.data)[0];
{% endfor %}

{% if lh.dats|direct(lh)|soa|length > 0 %}
    kernel::op2_stride_direct = f2c::round32(getSetSizeFromOpArg(&arg{{lh.args|direct(lh)|soa(lh)|first|attr("id")}}));
{% endif %}
{% for dat in lh.dats|indirect(lh)|soa %}
    kernel::op2_stride_dat{{dat.id}} = f2c::round32(getSetSizeFromOpArg(&arg{{dat.arg_id}}));
{% endfor %}

{% for arg in lh.args|gbl if arg is min or arg is max or arg is work %}
    static {{arg.typ.c()}}* gbl{{arg.id}}_ref_d = nullptr;
{% endfor %}

    op_profile_next("Get Kernel");
    auto *kernel_inst = info.get_kernel();
    op_profile_exit();

{% if lh is direct %}
    auto [block_limit, block_size] = info.get_launch_config(kernel_inst, set->size);
    block_limit = std::min(block_limit, getBlockLimit(args, n_args, block_size, "{{lh.name}}"));

    int num_blocks = (set->size + (block_size - 1)) / block_size;
    num_blocks = std::min(num_blocks, block_limit);
    int max_blocks = num_blocks;
{% elif config.atomics %}
    {% if lh.args|gbl|reduction|length == 0 %}
    std::array<int, 3> sections = {0, set->core_size, set->size + set->exec_size};
    {% else %}
    std::array<int, 4> sections = {0, set->core_size, set->size, set->size + set->exec_size};
{% endif %}

    auto [block_limit, block_size] = info.get_launch_config(kernel_inst, set->core_size);
    block_limit = std::min(block_limit, getBlockLimit(args, n_args, block_size, "{{lh.name}}"));

    int max_blocks = 0;
    for (int i = 1; i < sections.size(); ++i)
        max_blocks = std::max(max_blocks, (sections[i] - sections[i - 1] + (block_size - 1)) / block_size);

    max_blocks = std::min(max_blocks, block_limit);
{% if use_smem_atomics %}

    // hier_smem_atomic: fetch the plan (block partition + per-block distinct
    // indirect element numbering, no colouring) and decide whether every
    // block's staging buffers fit in shared memory. Falls back to the plain
    // global-atomics wrapper if not.
    int n_dats_indirect = {{lh.dats|indirect(lh)|length}};
    std::array<int, {{lh.args|length}}> dats_indirect = {
    {%- for arg in lh.args -%}
        {{lh.dats|indirect(lh)|index(lh.dat(arg)) if arg is dat and arg is indirect else "-1"}}
        {{-", " if not loop.last}}
    {%- endfor -%}
    };

    op_profile_enter("Plan");

#ifdef OP_PART_SIZE_{{kernel_idx}}
    int part_size = OP_PART_SIZE_{{kernel_idx}};
#else
    int part_size = OP_part_size;
#endif

    op_plan *plan = op_plan_get_stage_upload("{{lh.name}}_smem", set, part_size, n_args,
                        args, n_dats_indirect, dats_indirect.data(), OP_STAGE_INC, 1);

    int exec_length = set->size + set->exec_size;

    static int max_smem_optin = -1;
    if (max_smem_optin < 0) {
        int device;
        CUDA_SAFE_CALL({{api_prefix}}GetDevice(&device));
        CUDA_SAFE_CALL({{api_prefix}}DeviceGetAttribute(&max_smem_optin,
            gpuDevAttrMaxSharedMemoryPerBlockOptin, device));
    }

    static bool smem_atomics_env = true;
    static bool smem_atomics_env_read = false;
    if (!smem_atomics_env_read) {
        const char *env = std::getenv("OP_SMEM_ATOMICS");
        if (env != nullptr && (std::string(env) == "0" || std::string(env) == "no" || std::string(env) == "false"))
            smem_atomics_env = false;
        smem_atomics_env_read = true;
    }

    const bool use_smem = smem_atomics_env && plan->ninds_staged > 0 &&
                          plan->nshared > 0 && plan->nshared <= max_smem_optin;

    static op::f2c::KernelInfo info_smem("op2_k_{{lh.name}}{{variant}}_smem_wrapper",
                                         (void *)op2_k_{{lh.name}}{{variant}}_smem_wrapper,
                                         op2_k_{{lh.name}}{{variant}}_src);

    if (first_invocation_smem) {
{% if lh.dats|direct(lh)|soa|length > 0 %}
        info_smem.add_param("op2_stride_direct_d", &kernel::op2_stride_direct, &kernel::op2_stride_direct_d);
{% endif %}
{% for dat in lh.dats|indirect(lh)|soa %}
        info_smem.add_param("op2_stride_dat{{dat.id}}_d", &kernel::op2_stride_dat{{dat.id}}, &kernel::op2_stride_dat{{dat.id}}_d);
{% endfor %}
{% for const in lh.consts if lh.const_types.get("op2_const_" + const + "_d") is not fcharacter %}
    {% if lh.const_types.get("op2_const_" + const + "_d") is farray %}
        info_smem.add_param("op2_const_{{const}}_d", {{"op2_const_" if lang.user_consts_module is none}}{{const}}, sizeof(op2_const_{{const}}_d) / sizeof({{"op2_const_" if lang.user_consts_module is none}}{{const}}[0]), op2_const_{{const}}_d, &op2_const_{{const}}_hash);
    {% else %}
        info_smem.add_param("op2_const_{{const}}_d", &{{"op2_const_" if lang.user_consts_module is none}}{{const}}, &op2_const_{{const}}_d, &op2_const_{{const}}_hash);
    {% endif %}
{% endfor %}
{% for arg in lh.args|gbl|read|scalar %}
        info_smem.add_param("op2_gbl{{arg.id}}_d", &kernel::op2_gbl{{arg.id}});
{% endfor %}

        first_invocation_smem = false;
    }

    op_profile_exit();

    op::f2c::JitKernel *kernel_inst_smem = nullptr;
    if (use_smem) {
        op_profile_enter("Get Kernel");
        kernel_inst_smem = info_smem.get_kernel();
        op_profile_exit();
    }
{% endif %}
{% elif config.color2 %}
    int n_dats_indirect = {{lh.dats|indirect(lh)|length}};
    std::array<int, {{lh.args|length}}> dats_indirect = {
    {%- for arg in lh.args -%}
        {{lh.dats|indirect(lh)|index(lh.dat(arg)) if arg is dat and arg is indirect else "-1"}}
        {{-", " if not loop.last}}
    {%- endfor -%}
    };

    op_profile_enter("Plan");

#ifdef OP_PART_SIZE_{{kernel_idx}}
    int part_size = OP_PART_SIZE_{{kernel_idx}};
#else
    int part_size = OP_part_size;
#endif

    op_plan *plan = op_plan_get_stage("{{lh.name}}", set, part_size, n_args,
                        args, n_dats_indirect, dats_indirect.data(), OP_COLOR2);

    int max_size = 0;
    for (int col = 0; col < plan->ncolors; ++col) {
        int start = plan->col_offsets[0][col];
        int end = plan->col_offsets[0][col + 1];

        max_size = std::max(max_size, end - start);
    }

    auto [block_limit, block_size] = info.get_launch_config(kernel_inst, max_size);
    block_limit = std::min(block_limit, getBlockLimit(args, n_args, block_size, "{{lh.name}}"));

    int max_blocks = 0;
    for (int col = 0; col < plan->ncolors; ++col) {
        int start = plan->col_offsets[0][col];
        int end = plan->col_offsets[0][col + 1];

        int num_blocks = (end - start + (block_size - 1)) / block_size;
        max_blocks = std::max(max_blocks, num_blocks);
    }

    max_blocks = std::min(max_blocks, block_limit);
    op_profile_exit();
{% endif %}

{% if lh.args|opt|length > 0 %}
    unsigned opt_flags = 0;
    {% for arg in lh.args|opt %}
    if (arg{{arg.id}}.opt) opt_flags |= 1 << {{lh.optIdx(arg)}};
    {% endfor %}
{% endif %}

    op_profile_enter("Prepare GBLs");
    prepareDeviceGbls(args, n_args, block_size * max_blocks);
    bool exit_sync = false;

{% for arg in lh.args %}
    arg{{arg.id}} = args[{{loop.index0}}];
{% endfor %}

    op_profile_next("Update GBL Refs");
{% for arg in args_gbl_per_thread|select2("min", "max", "work") %}
    if (gbl{{arg.id}}_ref_d == nullptr{{" && arg%s.opt == 1" % arg.id if arg is opt}}) {
        CUDA_SAFE_CALL({{api_prefix}}Malloc(&gbl{{arg.id}}_ref_d, {{gbl_dim(arg)}} * sizeof({{arg.typ.c()}})));
    }

    {{"if (arg%s.opt == 1) " % arg.id if arg is opt-}}
        CUDA_SAFE_CALL({{api_prefix}}MemcpyAsync(gbl{{arg.id}}_ref_d, arg{{arg.id}}.data, {{gbl_dim(arg)}} * sizeof({{arg.typ.c()}}), {{api_prefix}}MemcpyHostToDevice, 0));
{% endfor %}

{% if args_gbl_per_thread|length > 0 %}
    op_profile_next("Init GBLs");

    int stride_gbl = block_size * max_blocks;
    {{init_gbls()|indent}}
{% endif %}

    op_profile_exit();
    op_profile_next("Computation");

{% if lh is direct %}
    int start = 0;
    int end = set->size;

    op_profile_enter("Kernel");

    int size = f2c::round32(set->size);
    {{kernel_call()|indent}}

    op_profile_next("Process GBLs");
    {{process_gbls()|indent}}

    op_profile_exit();
{% elif config.atomics %}
    op_profile_enter("Kernel");

    for (int round = 1; round < sections.size(); ++round) {
        if (round == 2) {
            op_profile_next("MPI Wait");
            op_mpi_wait_all_grouped(n_args, args, 2);
            op_profile_next("Kernel");
        }

        int start = sections[round - 1];
        int end = sections[round];

        if (end - start > 0) {
            {% if use_smem_atomics %}
            if (use_smem) {
                // Map the MPI section (core / owned / exec) directly to the plan's
                // nblocks_core and nblocks_owned scalar boundaries recorded on creation.
                int block0 = 0, block1 = 0;
                if (round == 1) {
                    block0 = 0;
                    block1 = set->core_size > 0 ? plan->nblocks_core : plan->nblocks_owned;
                } else if (round == 2) {
                    block0 = set->core_size > 0 ? plan->nblocks_core : plan->nblocks_owned;
                    block1 = sections.size() == 4 ? plan->nblocks_owned : plan->nblocks;
                } else {
                    block0 = plan->nblocks_owned;
                    block1 = plan->nblocks;
                }

                int num_blocks = block1 - block0;
                int nstaged = plan->ninds_staged;

                int size = f2c::round32(set->size + set->exec_size);
                {{kernel_call_smem()|indent(16)}}
            } else
            {% endif %}
            {
            int num_blocks = (end - start + (block_size - 1)) / block_size;
            num_blocks = std::min(num_blocks, block_limit);

            int size = f2c::round32(set->size + set->exec_size);
            {{kernel_call()|indent(12)}}
            }
        }

    {% if lh.args|gbl|reject("read")|list|length > 0 %}
        if (round == 2) {
            op_profile_next("Process GBLs");
            {{process_gbls()|indent(12)}}
            op_profile_next("Kernel");
        }
    {% endif %}
    }

    op_profile_exit();
{% else %}
    op_profile_enter("Kernel");

    for (int col = 0; col < plan->ncolors; ++col) {
        if (col == plan->ncolors_core) {
            op_profile_next("MPI Wait");
            op_mpi_wait_all_grouped(n_args, args, 2);
            op_profile_next("Kernel");
        }

        int start = plan->col_offsets[0][col];
        int end = plan->col_offsets[0][col + 1];

        int num_blocks = (end - start + (block_size - 1)) / block_size;
        num_blocks = std::min(num_blocks, block_limit);

        int size = f2c::round32(set->size + set->exec_size);
        {{kernel_call()|indent(8)}}

    {% if lh.args|gbl|reject("read")|list|length > 0 %}
        if (col == plan->ncolors_owned - 1) {
            op_profile_next("Process GBLs");
            {{process_gbls()|indent(12)}}
            op_profile_next("Kernel");
        }
    {% endif %}
    }

    op_profile_exit();
{% endif %}

    op_profile_exit();

    op_profile_enter("Finalise");
{% for arg in lh.args|gbl|reduction %}
    op_mpi_reduce(&arg{{arg.id}}, ({{arg.typ.c()}} *)arg{{arg.id}}.data);
{% endfor %}

    op_mpi_set_dirtybit_cuda(n_args, args);
    if (exit_sync) CUDA_SAFE_CALL({{api_prefix}}StreamSynchronize(0));

    op_profile_exit();
    op_profile_exit();
}

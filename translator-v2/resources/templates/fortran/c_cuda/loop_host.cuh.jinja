{#- Seed one staged region through the single owner of each of its slots. -#}
{% macro hier_smem_init(strategy, arg, index) %}
{% set dat = lh.dat(arg) %}
{% set group = group_dats[strategy]|index(arg.dat_id) %}
        for (int n = op2_source_begin + threadIdx.x; n < op2_source_end;
             n += blockDim.x) {
{% if arg is opt %}
            if (((1 << {{lh.optIdx(arg)}}) & opt_flags) == 0)
                break;

{% endif %}
            // Only owners are ever marked exclusive, so this covers both.
            f2c::HierSmemStageWord word = stage_words[{{index}} * stride + n];
            if (!f2c::hier_smem_stage_exclusive(word))
                continue;

            int target = {{map_lookup(arg)}};
            f2c::hier_smem_seed(word, {{hier_smem_global(arg, dat)}}, op2_stage{{group}}, op2_stage{{group}}_count, {{dat_dim_w(dat)}});
        }
{% endmacro %}

{#- One staged slot flushed back to its global target. -#}
{% macro hier_smem_flush(strategy, arg, index) %}
{% set dat = lh.dat(arg) %}
{% set group = group_dats[strategy]|index(arg.dat_id) %}
        for (int n = op2_source_begin + threadIdx.x; n < op2_source_end;
             n += blockDim.x) {
{% if arg is opt %}
            if (((1 << {{lh.optIdx(arg)}}) & opt_flags) == 0)
                break;

{% endif %}
            f2c::HierSmemStageWord word = stage_words[{{index}} * stride + n];
            if (!f2c::hier_smem_stage_owner(word))
                continue;

            int target = {{map_lookup(arg)}};
            f2c::hier_smem_flush(word, {{hier_smem_global(arg, dat)}}, op2_stage{{group}}, op2_stage{{group}}_count, {{dat_dim_w(dat)}});
        }
{% endmacro %}

{#- Apply a chunk's elements to their staged slots one thread colour at a
    time.  In the parallel shape every element computes at once into
    per-thread increments, and only applying them is coloured. -#}
{%- macro hier_colour_passes(jit) %}
        const int op2_colours = chunk_thread_colours[chunk];
        for (int op2_base = op2_source_begin; op2_base < op2_source_end;
             op2_base += blockDim.x) {
            const int n = op2_base + threadIdx.x;
            const int op2_colour = n < op2_source_end ? thread_colours[n] : -1;
    {% if hier_colouring_parallel %}
        {% for arg in args_hier_atomics %}
            {{lh.dat(arg).typ.c()}} op2_local{{arg.id}}[{{lh.dat(arg).dim}}] = {};
        {% endfor %}

            if (op2_colour >= 0) {
                {{kernel_call(jit, "hier_colouring", true)|indent(16)}}
            }

            // Every staged read completes before any slot changes.
            __syncthreads();

            for (int op2_pass = 0; op2_pass < op2_colours; ++op2_pass) {
                if (op2_colour == op2_pass) {
        {% for arg in args_hier_atomics %}
            {% if arg is opt %}
                    if (((1 << {{lh.optIdx(arg)}}) & opt_flags) != 0)
                        f2c::hier_smem_add({{hier_smem_slot(arg, "hier_colouring")}}, op2_local{{arg.id}}, {{lh.dat(arg).dim}});
            {% else %}
                    f2c::hier_smem_add({{hier_smem_slot(arg, "hier_colouring")}}, op2_local{{arg.id}}, {{lh.dat(arg).dim}});
            {% endif %}
        {% endfor %}
                }

                __syncthreads();
            }
    {% else %}
            for (int op2_pass = 0; op2_pass < op2_colours; ++op2_pass) {
                if (op2_colour == op2_pass) {
                    {{kernel_call(jit, "hier_colouring")|indent(20)}}
                }

                __syncthreads();
            }
    {% endif %}
        }
{%- endmacro %}

{#- Stage a chunk's grouped targets in shared memory, apply its elements to
    them, then flush each target once.  hier_atomics clears its slots and
    accumulates into them with shared atomics, seeding only owners its section
    keeps exclusive.  hier_colouring seeds every slot, since a launch's chunks
    share no target, and applies its elements by thread colour. -#}
{%- macro hier_smem_body(strategy, jit = false) %}
    {% set dats = group_dats[strategy] %}
    {% set grouped = group_args[strategy] %}
    extern __shared__ char op2_stage_smem[];

    {% for dat_id in dats %}
    const bool op2_stage{{loop.index0}}_active = {{hier_smem_group_active(strategy, dat_id)}};
    {% endfor %}

    {% if strategy == "hier_colouring" %}
    // Physical blocks grid-stride over this launch's chunks, which share no
    // target of any group.
    for (int op2_i = chunk_begin + blockIdx.x; op2_i < chunk_end;
         op2_i += gridDim.x) {
        const int chunk = chunk_order[op2_i];
    {% else %}
    // Physical blocks grid-stride over this section's plan chunks; the plan
    // guarantees no chunk spans a section boundary.
    for (int chunk = chunk_begin + blockIdx.x; chunk < chunk_end;
         chunk += gridDim.x) {
    {% endif %}
        const int op2_source_begin = source_offsets[chunk];
        const int op2_source_end = source_offsets[chunk + 1];
        const int *op2_chunk_counts =
            stage_counts + chunk * {{dats|length}};

        // Walk the same region layout the host planner sized this chunk for.
        char *op2_stage_cursor = op2_stage_smem;
    {% for dat_id in dats %}
        {% set dat = lh.dat(dat_id) %}
        const int op2_stage{{loop.index0}}_count = op2_stage{{loop.index0}}_active ? op2_chunk_counts[{{loop.index0}}] : 0;
        {{dat.typ.c()}} *op2_stage{{loop.index0}} = f2c::hier_smem_region<{{dat.typ.c()}}>(op2_stage_cursor, op2_stage{{loop.index0}}_count, {{dat_dim_w(dat)}});
    {% endfor %}

    {% if strategy == "hier_atomics" %}
        // Clear every region before accumulating into it.
        {% for dat_id in dats %}
        f2c::hier_smem_clear(op2_stage{{loop.index0}}, op2_stage{{loop.index0}}_count * {{dat_dim_w(lh.dat(dat_id))}}, threadIdx.x, blockDim.x);
        {% endfor %}
        __syncthreads();

        // Seed the exclusive slots from their targets' current values so the
        // flush can store rather than read-modify-write.  The load lands here,
        // where the accumulation below hides its latency.  Skipped wholesale
        // when the plan has no exclusive owner, since the scan would otherwise
        // re-read every packed word from global memory to find nothing.
        if (has_exclusive) {
        {% for arg in grouped %}
{{- hier_smem_init(strategy, arg, loop.index0)}}
        {% endfor %}
            __syncthreads();
        }

        for (int n = op2_source_begin + threadIdx.x; n < op2_source_end;
             n += blockDim.x) {
            {{kernel_call(jit, strategy)|indent(12)}}
        }
    {% else %}
        // Seed every slot from its target, so the elements read and update
        // the targets' current values.
        {% for arg in grouped %}
{{- hier_smem_init(strategy, arg, loop.index0)}}
        {% endfor %}
        __syncthreads();
{{hier_colour_passes(jit)}}
    {% endif %}

        __syncthreads();

        // One write per distinct target reaches global memory.
    {% for arg in grouped %}
{{- hier_smem_flush(strategy, arg, loop.index0)}}
    {% endfor %}

        // Keep the next iteration from reusing memory a warp is still
        // flushing.
        __syncthreads();
    }
{%- endmacro %}


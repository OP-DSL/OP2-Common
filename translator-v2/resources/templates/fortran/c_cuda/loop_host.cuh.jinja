{# The staged wrapper accumulates every indirect increment in shared memory, so
   a loop qualifies only when all of them can be staged together: a supported
   scalar type, and a single map component per argument.  Vec arguments carry a
   negative map_idx that this template does not expand, so they disqualify the
   loop rather than reaching the planner, which indexes by map component.  Dat
   ids are collected in first-use order and become the staged-dat groups the
   descriptor and the shared-region layout are ordered by. #}
{%- set args_hier_smem = lh.args|dat|indirect(lh)|inc|list -%}
{%- set hier_smem = namespace(supported=true, dat_ids=[]) -%}
{%- for arg in args_hier_smem -%}
    {%- set typ = lh.dat(arg).typ -%}
    {%- if arg is vec -%}
        {%- set hier_smem.supported = false -%}
    {%- elif not ((typ is instance(OP.Float) and typ.size in [32, 64]) or
                  (typ is instance(OP.Int) and typ.signed and typ.size == 32)) -%}
        {%- set hier_smem.supported = false -%}
    {%- elif arg.dat_id not in hier_smem.dat_ids -%}
        {%- set hier_smem.dat_ids = hier_smem.dat_ids + [arg.dat_id] -%}
    {%- endif -%}
{%- endfor -%}
{%- set has_hier_smem = config.atomics and args_hier_smem|length > 0 and hier_smem.supported -%}

{%- macro gbl_dim_w(arg) -%}
    {%- if arg.dim is not none -%}
{{arg.dim}}
    {%- else -%}
arg{{arg.id}}_dim
    {%- endif -%}
{%- endmacro -%}

{%- macro dat_dim_w(dat) -%}
    {%- if dat.dim is not none -%}
{{dat.dim}}
    {%- else -%}
dat{{dat.id}}_dim
    {%- endif -%}
{%- endmacro -%}

{%- macro hier_smem_scalar_type(dat) -%}
    {%- if dat.typ is instance(OP.Float) -%}
op::f2c::HierSmemScalarType::f{{dat.typ.size}}
    {%- else -%}
op::f2c::HierSmemScalarType::i32
    {%- endif -%}
{%- endmacro -%}

{%- macro map_idx(arg) -%}
    {%- if arg is runtime_map_idx %}
arg{{arg.id}}_idx
    {%- else -%}
{{arg.map_idx - 1}}
    {%- endif -%}
{%- endmacro -%}

{% macro map_lookup(arg) -%}
map{{arg.map_id}}[{{map_idx(arg)}} * stride + n]
{%- endmacro %}

{%- macro arg_to_pointer_cuda(arg, jit = false, staged = false) %}
    {%- if arg is idx and arg is indirect -%}
idx{{arg.id}}
    {%- elif arg is idx -%}
idx
    {%- elif arg is opt and arg is scalar(lh) -%}
        {%- if arg is gbl or arg is info %}
            {%- set zero_type = arg.typ.c() -%}
        {%- else -%}
            {%- set zero_type = lh.dat(arg).typ.c() -%}
        {%- endif -%}
(1 << {{lh.optIdx(arg)}}) & opt_flags ? {{arg_to_pointer2(arg, jit, staged)}} : zero_{{zero_type}}
    {%- else -%}
{{arg_to_pointer2(arg, jit, staged)}}
    {%- endif -%}
{%- endmacro -%}

{%- macro arg_to_pointer2(arg, jit, staged = false) -%}
    {%- if jit and arg is gbl and arg is read and arg is scalar -%}
op2_gbl{{arg.id}}_d
    {%- elif arg is gbl and arg is read and arg is scalar -%}
gbl{{arg.id}}
    {%- elif arg is scalar(lh) -%}
{{arg_to_pointer3(arg, staged)}}.data[0]
    {%- else -%}
{{arg_to_pointer3(arg, staged)}}
    {%- endif -%}
{%- endmacro -%}

{%- macro arg_to_pointer3(arg, staged = false) -%}
    {%- if arg is info -%}
f2c::Ptr{info{{arg.id}} + thread_id, stride_gbl}
    {%- elif arg in args_gbl_per_thread -%}
f2c::Ptr{gbl{{arg.id}} + thread_id, stride_gbl}
    {%- elif arg is gbl -%}
f2c::Ptr{gbl{{arg.id}}}
    {%- else -%}
{{arg_to_pointer4(arg, staged)}}
    {%- endif -%}
{%- endmacro -%}

{%- macro arg_to_pointer4(arg, staged = false) -%}
    {%- if staged and arg in args_hier_smem -%}
        {%- set group = hier_smem.dat_ids|index(arg.dat_id) -%}
f2c::Ptr{op2_stage{{group}} + f2c::hier_smem_stage_slot(stage_words[{{args_hier_smem|index(arg)}} * stride + n]), op2_stage{{group}}_count}
    {%- elif arg is direct and lh.dat(arg) is soa -%}
f2c::Ptr{dat{{arg.dat_id}} + n, op2_stride_direct_d}
    {%- elif arg is direct -%}
f2c::Ptr{dat{{arg.dat_id}} + n * {{dat_dim_w(lh.dat(arg))}}}
    {%- elif lh.dat(arg) is soa -%}
f2c::Ptr{dat{{arg.dat_id}} + {{map_lookup(arg)}}, op2_stride_dat{{arg.dat_id}}_d}
    {%- else -%}
f2c::Ptr{dat{{arg.dat_id}} + {{map_lookup(arg)}} * {{dat_dim_w(lh.dat(arg))}}}
    {%- endif -%}
{%- endmacro -%}


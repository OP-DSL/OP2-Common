{#- Argument groups for the hierarchical strategies, with their dat ids in
    first-use order.  hier_atomics stages every indirect increment;
    hier_colouring colours every indirect argument on a dat the loop
    increments or read-writes.  The translator lists a hierarchical strategy
    only when its group arguments have one map component and a supported
    scalar type. -#}
{%- set args_hier_atomics = lh.args|dat|indirect(lh)|inc|list -%}
{%- set updated = namespace(ids=[]) -%}
{%- for arg in lh.args|dat|indirect(lh) -%}
    {%- if (arg is inc or arg is read_write) and arg.dat_id not in updated.ids -%}
        {%- set updated.ids = updated.ids + [arg.dat_id] -%}
    {%- endif -%}
{%- endfor -%}
{%- set args_hier_colouring = lh.args|dat|indirect(lh)|selectattr("dat_id", "in", updated.ids)|list -%}
{%- set group_ids = namespace(hier_atomics=[], hier_colouring=[]) -%}
{%- for arg in args_hier_atomics -%}
    {%- if arg.dat_id not in group_ids.hier_atomics -%}
        {%- set group_ids.hier_atomics = group_ids.hier_atomics + [arg.dat_id] -%}
    {%- endif -%}
{%- endfor -%}
{%- for arg in args_hier_colouring -%}
    {%- if arg.dat_id not in group_ids.hier_colouring -%}
        {%- set group_ids.hier_colouring = group_ids.hier_colouring + [arg.dat_id] -%}
    {%- endif -%}
{%- endfor -%}
{%- set group_args = {"hier_atomics": args_hier_atomics, "hier_colouring": args_hier_colouring} -%}
{%- set group_dats = {"hier_atomics": group_ids.hier_atomics, "hier_colouring": group_ids.hier_colouring} -%}

{#- Whether hierarchical colouring can compute every element of a chunk at
    once: its groups only increment and read, and every increment's dimension
    is known, so each thread can keep its increments in registers until its
    colour's turn. -#}
{%- set colour_shape = namespace(parallel=true) -%}
{%- for arg in args_hier_colouring -%}
    {%- if not (arg is inc or arg is read) -%}
        {%- set colour_shape.parallel = false -%}
    {%- endif -%}
{%- endfor -%}
{%- for arg in args_hier_atomics -%}
    {%- if lh.dat(arg).dim is none -%}
        {%- set colour_shape.parallel = false -%}
    {%- endif -%}
{%- endfor -%}
{%- set hier_colouring_parallel = colour_shape.parallel -%}


{% if lh.dats|direct(lh)|soa|length > 0 %}
int op2_stride_direct;
__constant__ int op2_stride_direct_d;
{% endif %}

{% for dat in lh.dats|indirect(lh)|soa %}
int op2_stride_dat{{dat.id}};
__constant__ int op2_stride_dat{{dat.id}}_d;
{% endfor %}

{% for arg in lh.args|gbl|read|scalar %}
{{arg.typ.c()}} op2_gbl{{arg.id}};
{% endfor %}

{{kernel_func}}}

{#- Whether any argument in a staged group is active for this launch. -#}
{%- macro hier_smem_group_active(dat_id) -%}
    {%- set members = args_hier_smem|selectattr("dat_id", "eq", dat_id)|list -%}
    {%- if members|reject("opt")|list|length > 0 -%}
true
    {%- else -%}
        {%- for arg in members -%}
((1 << {{lh.optIdx(arg)}}) & opt_flags) != 0{{" || " if not loop.last}}
        {%- endfor -%}
    {%- endif -%}
{%- endmacro -%}

{#- One staged increment flushed back to its global target. -#}
{% macro hier_smem_flush(arg, index) %}
{% set dat = lh.dat(arg) %}
{% set group = hier_smem.dat_ids|index(arg.dat_id) %}
        for (int n = op2_source_begin + threadIdx.x; n < op2_source_end;
             n += blockDim.x) {
{% if arg is opt %}
            if (((1 << {{lh.optIdx(arg)}}) & opt_flags) == 0)
                break;

{% endif %}
            f2c::HierSmemStageWord word = stage_words[{{index}} * stride + n];
            if (!f2c::hier_smem_stage_owner(word))
                continue;

            unsigned int slot = f2c::hier_smem_stage_slot(word);
            int target = {{map_lookup(arg)}};

            for (int c = 0; c < {{dat_dim_w(dat)}}; ++c)
{% if dat is soa %}
                atomicAdd(
                    &dat{{arg.dat_id}}[target + c * op2_stride_dat{{arg.dat_id}}_d],
                    op2_stage{{group}}[slot + c * op2_stage{{group}}_count]);
{% else %}
                atomicAdd(
                    &dat{{arg.dat_id}}[target * {{dat_dim_w(dat)}} + c],
                    op2_stage{{group}}[slot + c * op2_stage{{group}}_count]);
{% endif %}
        }
{% endmacro %}

{%- macro hier_smem_body(jit = false) %}
    extern __shared__ char op2_stage_smem[];

    {% for dat_id in hier_smem.dat_ids %}
    const bool op2_stage{{loop.index0}}_active = {{hier_smem_group_active(dat_id)}};
    {% endfor %}

    // Physical blocks grid-stride over this section's plan chunks; the plan
    // guarantees no chunk spans a section boundary.
    for (int chunk = chunk_begin + blockIdx.x; chunk < chunk_end;
         chunk += gridDim.x) {
        const int op2_source_begin = source_offsets[chunk];
        const int op2_source_end = source_offsets[chunk + 1];
        const int *op2_chunk_counts =
            stage_counts + chunk * {{hier_smem.dat_ids|length}};

        // Walk the same region layout the host planner sized this chunk for.
        char *op2_stage_cursor = op2_stage_smem;
    {% for dat_id in hier_smem.dat_ids %}
        {% set dat = lh.dat(dat_id) %}
        {% if not loop.first %}
        op2_stage_cursor = (char *)(((size_t)op2_stage_cursor +
                                     (alignof({{dat.typ.c()}}) - 1)) &
                                    ~(size_t)(alignof({{dat.typ.c()}}) - 1));
        {% endif %}
        {{dat.typ.c()}} *op2_stage{{loop.index0}} =
            ({{dat.typ.c()}} *)op2_stage_cursor;
        const int op2_stage{{loop.index0}}_count =
            op2_stage{{loop.index0}}_active ? op2_chunk_counts[{{loop.index0}}] : 0;
        op2_stage_cursor += (size_t)op2_stage{{loop.index0}}_count *
                            {{dat_dim_w(dat)}} * sizeof({{dat.typ.c()}});
    {% endfor %}

        // Clear every region before accumulating into it.
    {% for dat_id in hier_smem.dat_ids %}
        for (int i = threadIdx.x;
             i < op2_stage{{loop.index0}}_count * {{dat_dim_w(lh.dat(dat_id))}};
             i += blockDim.x)
            op2_stage{{loop.index0}}[i] = 0;
    {% endfor %}
        __syncthreads();

        for (int n = op2_source_begin + threadIdx.x; n < op2_source_end;
             n += blockDim.x) {
    {% if lh.args|idx|direct|length > 0 %}
            int idx = n + 1;
    {% endif %}
    {% for arg in lh.args|idx|indirect %}
            int idx{{arg.id}} = {{map_lookup(arg)}} + 1;
    {% endfor %}
            {{lh.kernel}}(
    {% for arg in lh.args %}
                {{arg_to_pointer_cuda(arg, jit, staged=true)}}{{"," if not loop.last}}
    {% endfor %}
            );
        }

        __syncthreads();

        // One contribution per distinct target reaches global memory.
    {% for arg in args_hier_smem %}
{{- hier_smem_flush(arg, loop.index0)}}
    {% endfor %}

        // Keep the next iteration from clearing memory a warp is still
        // flushing.
        __syncthreads();
    }
{%- endmacro %}

{% macro kernel_wrapper(jit = false, staged = false) %}
extern "C" __global__ {{"__launch_bounds__(128)" if config.hip}}
void op2_k_{{lh.name}}{{variant}}{{"_staged" if staged}}_wrapper(
    {% for dat in lh.dats %}

{%- macro variant_str() -%}
{{"Direct" if lh is direct else "Indirect"}}
{%- endmacro -%}

{%- set strategies = config.strategies -%}
{#- Enabled by default: plain, and chunk colouring over the set colouring
    floor; an atomic increment is a compare-and-swap loop on most CPUs. -#}
{%- set default_strategies = ["plain", "chunk_colouring", "colouring"] -%}

{#- Globals each thread keeps its own copy of. -#}
{%- set args_per_thread = lh.args|gbl|select2("reduction", "work")|list + lh.args|info|list -%}

{#- chunk_atomics' argument groups (fortran/schemes.py chunkGroups), as the
    c_cuda target groups them; the runtime stages them in the regions the
    staged body lays out.  chunk_colouring needs none: it colours by the
    call's updated dats. -#}
{%- set groups = config.chunk_groups -%}

{#- The kernel increments through op2_inc: atomically under atomics, in
    place under every other strategy, whose increments reach memory no other
    thread updates meanwhile. -#}
{%- set hooks = ["plain"] + (["atomic"] if "atomics" in strategies else []) -%}

{%- macro ctype(arg) -%}
{{lh.dat(arg).typ.c() if arg is dat else arg.typ.c()}}
{%- endmacro -%}

{%- macro dat_dim(dat) -%}
{{dat.dim if dat.dim is not none else "dat%s_dim" % dat.id}}
{%- endmacro -%}

{%- macro gbl_dim(arg) -%}
{{arg.dim if arg.dim is not none else "args[%s].dim" % arg.id}}
{%- endmacro -%}

{%- macro map_idx(arg) -%}
{{"args[%s].idx" % arg.id if arg is runtime_map_idx else arg.map_idx - 1}}
{%- endmacro -%}

{%- macro map_lookup(arg) -%}
map{{arg.map_id}}[n * map{{arg.map_id}}_dim + {{map_idx(arg)}}]
{%- endmacro -%}

{#- An argument's global data for element n. -#}
{%- macro global_address(arg) -%}
    {%- if arg is direct -%}
dat{{arg.dat_id}} + n * {{dat_dim(lh.dat(arg))}}
    {%- else -%}
dat{{arg.dat_id}} + {{map_lookup(arg)}} * {{dat_dim(lh.dat(arg))}}
    {%- endif -%}
{%- endmacro -%}

{#- An argument as the kernel sees it.  mode "range" passes global data and
    this thread's globals; "staged" chunk_atomics' increments as their slots
    in the chunk's scratch. -#}
{%- macro arg_ptr(arg, mode) -%}
    {%- if arg is gbl or arg is info -%}
f2c::Ptr{gbl{{arg.id}}}
    {%- elif mode == "staged" and arg in groups.chunk_atomics.args -%}
f2c::Ptr{op2_stage{{groups.chunk_atomics.group(arg)}} + stage_words[{{groups.chunk_atomics.position(arg)}} * stride + n] * {{dat_dim(lh.dat(arg))}}}
    {%- else -%}
f2c::Ptr{ {{-global_address(arg)-}} }
    {%- endif -%}
{%- endmacro -%}

{%- macro arg_value(arg, mode) -%}
    {%- if arg is idx and arg is indirect -%}
idx{{arg.id}}
    {%- elif arg is idx -%}
idx
    {%- elif arg is opt and arg is scalar(lh) -%}
(opt{{arg.id}} ? {{arg_ptr(arg, mode)}}.data[0] : zero_{{ctype(arg)}})
    {%- elif arg is scalar(lh) -%}
{{arg_ptr(arg, mode)}}.data[0]
    {%- else -%}
{{arg_ptr(arg, mode)}}
    {%- endif -%}
{%- endmacro -%}

{#- One call of the translated kernel for element n. -#}
{%- macro kernel_call(mode) -%}
{% if lh.args|idx|direct|length > 0 %}
[[maybe_unused]] const int idx = n + 1;
{% endif %}
{% for arg in lh.args|idx|indirect %}
const int idx{{arg.id}} = {{map_lookup(arg)}} + 1;
{% endfor %}
kernel::{{lh.kernel}}(
{% for arg in lh.args %}
    {{arg_value(arg, mode)}}{{"," if not loop.last}}
{% endfor %}
);
{%- endmacro -%}

{#- What every body reads from the arguments once per call. -#}
{% macro prologue() %}
{% for dat in lh.dats %}
    {% set cv = "const " if dat is read_in(lh) else "" %}
    [[maybe_unused]] {{cv}}{{dat.typ.c()}} *const dat{{dat.id}} =
        reinterpret_cast<{{cv}}{{dat.typ.c()}} *>(args[{{dat.arg_id}}].data);
    {% if dat.dim is none %}
    [[maybe_unused]] const int dat{{dat.id}}_dim = args[{{dat.arg_id}}].dim;
    {% endif %}
{% endfor %}
{% for map in lh.maps %}
    [[maybe_unused]] const int *const map{{map.id}} = args[{{map.arg_id}}].map_data;
    [[maybe_unused]] const int map{{map.id}}_dim =
        args[{{map.arg_id}}].map != nullptr ? args[{{map.arg_id}}].map->dim : 0;
{% endfor %}
{% for arg in lh.args|gbl if arg not in args_per_thread %}
    {% set cv = "const " if arg is read else "" %}
    [[maybe_unused]] {{cv}}{{arg.typ.c()}} *const gbl{{arg.id}} =
        reinterpret_cast<{{cv}}{{arg.typ.c()}} *>(args[{{arg.id}}].data);
{% endfor %}
{% for arg in args_per_thread %}
    [[maybe_unused]] {{arg.typ.c()}} *const gbl{{arg.id}} = work.global<{{arg.typ.c()}}>({{arg.id}});
{% endfor %}
{% for arg in lh.args|opt %}
    [[maybe_unused]] const bool opt{{arg.id}} = args[{{arg.id}}].opt != 0;
{% endfor %}
    [[maybe_unused]] int zero_int = 0;
    [[maybe_unused]] bool zero_bool = 0;
    [[maybe_unused]] float zero_float = 0;
    [[maybe_unused]] double zero_double = 0;
{% endmacro %}

{#- Whether any argument in a staged group is active for this call. -#}
{%- macro stage_group_active(dat_id) -%}
    {%- set members = groups.chunk_atomics.args|selectattr("dat_id", "eq", dat_id)|list -%}
    {%- if members|reject("opt")|list|length > 0 -%}
true
    {%- else -%}
        {%- for arg in members -%}
opt{{arg.id}}{{" || " if not loop.last}}
        {%- endfor -%}
    {%- endif -%}
{%- endmacro -%}

namespace op2_m_{{lh.name}}{{variant}} {

{% for hook in hooks %}
namespace op2_s_{{hook}} {

template<typename T, typename U>
static inline void op2_inc(T& target, U value) {
    f2c::{{hook}}_inc(target, value);
}

{{kernel_func}}}

{% endfor %}
}

{#- A thread's share of elements, or of a set colouring's positions. -#}
{% for hook in hooks %}
template<bool op2_ordered>
static void op2_k_{{lh.name}}{{variant}}_range_{{hook}}(const op::cpu::Work& work,
                                                op_arg *args) {
    namespace kernel = op2_m_{{lh.name}}{{variant}}::op2_s_{{hook}};
{{prologue()}}
    for (int op2_i = work.begin; op2_i < work.end; ++op2_i) {
        const int n = op2_ordered ? work.order[op2_i] : op2_i;
        {{kernel_call("range")|indent(8)}}
    }
}

{% endfor %}
{% if "chunk_atomics" in strategies %}
{#- One chunk of chunk_atomics: its increments accumulate in place in the
    thread's scratch, then each slot is added to its target atomically, as
    other threads' chunks may share it. -#}
static void op2_k_{{lh.name}}{{variant}}_staged(const op::cpu::Work& work,
                                         op_arg *args) {
    namespace kernel = op2_m_{{lh.name}}{{variant}}::op2_s_plain;
{{prologue()}}
    const auto& staging = work.plan->staging;
    const int stride = staging.stride;
    const op::plan::StageWord *const stage_words = staging.stage_words.data();
    const int *const op2_counts =
        staging.stage_counts.data() + work.chunk * {{groups.chunk_atomics.dats|length}};
    const int *const op2_slots =
        staging.slot_offsets.data() + work.chunk * {{groups.chunk_atomics.dats|length}};

    char *op2_cursor = work.scratch;
    {% for dat_id in groups.chunk_atomics.dats %}
        {% set dat = lh.dat(dat_id) %}
    const int op2_stage{{loop.index0}}_count =
        ({{stage_group_active(dat_id)}}) ? op2_counts[{{loop.index0}}] : 0;
    {{dat.typ.c()}} *const op2_stage{{loop.index0}} = f2c::stage_region<{{dat.typ.c()}}>(
        op2_cursor, op2_stage{{loop.index0}}_count, {{dat_dim(dat)}});
    f2c::stage_clear(op2_stage{{loop.index0}}, op2_stage{{loop.index0}}_count * {{dat_dim(dat)}}, 0, 1);
    {% endfor %}

    for (int n = work.begin; n < work.end; ++n) {
        {{kernel_call("staged")|indent(8)}}
    }

    {% for dat_id in groups.chunk_atomics.dats %}
        {% set dat = lh.dat(dat_id) %}
    for (int op2_s = 0; op2_s < op2_stage{{loop.index0}}_count; ++op2_s) {
        const int op2_target = staging.slot_targets[op2_slots[{{loop.index0}}] + op2_s];
        f2c::stage_flush(f2c::Ptr{dat{{dat_id}} + op2_target * {{dat_dim(dat)}}},
                         op2_stage{{loop.index0}}, op2_s, {{dat_dim(dat)}});
    }
    {% endfor %}
}

{% endif %}
{%- macro strategy_class(strategy) -%}
{{ {"plain": "Simple", "atomics": "Simple", "colouring": "Colouring",
    "chunk_atomics": "ChunkAtomics", "chunk_colouring": "ChunkColouring"}[strategy] }}
{%- endmacro -%}

{%- macro body(strategy) -%}
    {%- set hook = "atomic" if strategy == "atomics" else "plain" -%}
    {%- set ordered = "true" if strategy == "colouring" else "false" -%}
    {%- if strategy == "chunk_atomics" -%}
&op2_k_{{lh.name}}{{variant}}_staged
    {%- else -%}
&op2_k_{{lh.name}}{{variant}}_range_{{hook}}<{{ordered}}>
    {%- endif -%}
{%- endmacro -%}

static bool op2_k_{{lh.name}}{{variant}}_register(op::cpu::Loop& loop) {
{% for strategy in strategies %}
    {% if strategy == "chunk_atomics" %}
    static constexpr std::array<op::plan::ArgGroup, {{groups.chunk_atomics.args|length}}> chunk_atomics_groups = {{"{{"}}
        {% for arg in groups.chunk_atomics.args %}
        op::plan::ArgGroup{ {{arg.id}}, {{groups.chunk_atomics.group(arg)}} },
        {% endfor %}
    {{"}}"}};
    {% set tail = ", op::plan::ArgGroups{ chunk_atomics_groups, %d }" % groups.chunk_atomics.dats|length %}
    {% else %}
    {% set tail = "" %}
    {% endif %}
    loop.add<op::cpu::{{strategy_class(strategy)}}>(
        "{{strategy}}", op::loop::Default::{{"enabled" if strategy in default_strategies else "disabled"}},
        {{body(strategy)}}{{tail}});
{% endfor %}
    return true;
}

static op::cpu::Loop& op2_k_{{lh.name}}{{variant}}_loop() {
    static op::cpu::Loop loop(
        "{{lh.name}}", "c_OpenMP", "{{variant_str()}}",
        op::cpu::LoopDescription{ {{"true" if lh is direct else "false"}} });
    static const bool registered = op2_k_{{lh.name}}{{variant}}_register(loop);
    (void)registered;
    return loop;
}

extern "C" void op2_k_{{lh.name}}{{variant}}_c(
    op_set set,
{% for arg in lh.args %}
    op_arg arg{{arg.id}}{{"," if not loop.last}}
{% endfor %}
) {
    op_arg args[] = {
{% for arg in lh.args %}
        arg{{arg.id}}{{"," if not loop.last}}
{% endfor %}
    };

    op2_k_{{lh.name}}{{variant}}_loop().invoke(set, args, {{lh.args|length}});
}

{#- How a C++ kernel translated from Fortran takes its arguments, for the
    shared loop hosts: indices from 1, every data argument an
    op::kernel::Ptr but a one-component one, which it takes as its element,
    and a scalar global by value; an inactive optional one-component
    argument a zero of its type; the loop entered through bind(C). -#}
{%- set index_base = 1 -%}

{%- macro idx_arg(name) -%}
{{name}}
{%- endmacro -%}

{%- macro value(expr) -%}
{{expr}}
{%- endmacro -%}

{%- macro element(arg, expr) -%}
{{expr}}{{".data[0]" if arg is scalar(lh)}}
{%- endmacro -%}

{%- macro guarded(arg) -%}
{{"1" if arg is scalar(lh)}}
{%- endmacro -%}

{%- macro inactive(arg) -%}
zero_{{(arg if arg is gbl or arg is info else lh.dat(arg)).typ.c()}}
{%- endmacro -%}

{%- macro wrapper_locals() %}

    [[maybe_unused]] int zero_int = 0;
    [[maybe_unused]] bool zero_bool = 0;
    [[maybe_unused]] float zero_float = 0;
    [[maybe_unused]] double zero_double = 0;
{% endmacro -%}

{%- macro register_consts() -%}
{% for const in lh.consts if lh.const_types.get("op2_const_" + const + "_d") is not fcharacter %}
    {% if lh.const_types.get("op2_const_" + const + "_d") is farray %}
    loop.add_param("op2_const_{{const}}_d", {{"op2_const_" if lang.user_consts_module is none}}{{const}}, sizeof(op2_const_{{const}}_d) / sizeof({{"op2_const_" if lang.user_consts_module is none}}{{const}}[0]), op2_const_{{const}}_d, &op2_const_{{const}}_hash);
    {% else %}
    loop.add_param("op2_const_{{const}}_d", &{{"op2_const_" if lang.user_consts_module is none}}{{const}}, &op2_const_{{const}}_d, &op2_const_{{const}}_hash);
    {% endif %}
{% endfor %}
{%- endmacro -%}

{%- macro entry() -%}
extern "C" void op2_k_{{lh.name}}{{variant}}_c(
{%- endmacro -%}

{%- macro entry_prologue() -%}
{%- endmacro -%}

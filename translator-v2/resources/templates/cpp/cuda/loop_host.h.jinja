{%- macro arg_global_pointer(arg) -%}
    {%- if arg is direct and lh.dat(arg) is soa -%}
op::kernel::Ptr{dat{{arg.dat_id}} + n, op2_stride_direct_d}
    {%- elif arg is direct -%}
op::kernel::Ptr{dat{{arg.dat_id}} + n * {{dat_dim_w(lh.dat(arg))}}}

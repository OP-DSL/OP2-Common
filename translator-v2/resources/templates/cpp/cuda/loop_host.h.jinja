op::kernel::Ptr{op2_local{{arg.id}}}
    {%- elif staged is not none and arg in groups[staged].args -%}
{{stage_slot(arg, staged)}}
    {%- else -%}
{{arg_global_pointer(arg)}}
    {%- endif -%}
{%- endmacro -%}

{#- An argument's global data for element n, as an op::kernel::Ptr, whose

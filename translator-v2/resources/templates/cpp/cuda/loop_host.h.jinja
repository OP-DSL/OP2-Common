{#- A chunked wrapper's plan parameters: type, name, and the launch context
    field that binds it. -#}
{%- set staging_params = [
    ("const int *__restrict", "source_offsets", "launch.chunk.plan->source_offsets"),
    ("const op::plan::StageWord *__restrict", "stage_words", "launch.chunk.plan->stage_words"),
    ("const int *__restrict", "stage_counts", "launch.chunk.plan->stage_counts"),

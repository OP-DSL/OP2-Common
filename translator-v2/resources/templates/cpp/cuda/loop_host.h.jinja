{#- A lane per slot of each staged region, from the chunk's list of the
    region's targets, applies action: seed the slot from its target, store it
    back, or flush it with a global atomic. -#}
{% macro stage_slots(strategy, action) %}
{% for arg in groups[strategy].leaders() %}
    {% set dat = lh.dat(arg) %}
        for (int s = threadIdx.x; s < op2_stage{{loop.index0}}_count; s += blockDim.x) {
            const int target = slot_targets[op2_chunk_slots[{{loop.index0}}] + s];
            op::kernel::stage_{{action}}({{stage_global(arg, dat)}}, op2_stage{{loop.index0}}, s, {{dat_dim_w(dat)}});
        }
{% endfor %}
{% endmacro %}

{#- Apply a chunk's elements to their staged slots one thread colour at a
    time.  In the parallel shape every element computes at once into
    per-thread increments, and only applying them is coloured. -#}
{%- macro chunk_colour_passes() %}
        const int op2_colours = chunk_thread_colours[chunk];
        for (int op2_base = op2_source_begin; op2_base < op2_source_end;
             op2_base += blockDim.x) {
            const int n = op2_base + threadIdx.x;
            const int op2_colour = n < op2_source_end ? thread_colours[n] : -1;
    {% if chunk_colouring_parallel %}
        {% for arg in groups.chunk_atomics.args %}
            {{lh.dat(arg).typ.c()}} op2_local{{arg.id}}[{{dat_dim_w(lh.dat(arg))}}] = {};
        {% endfor %}

            if (op2_colour >= 0) {
                {{kernel_call(true, "chunk_colouring", "chunk_colouring", true)|indent(16)}}
            }

            // Every staged read completes before any slot changes.
            __syncthreads();

            for (int op2_pass = 0; op2_pass < op2_colours; ++op2_pass) {
                if (op2_colour == op2_pass) {
        {% for arg in groups.chunk_atomics.args %}
            {% if arg is opt %}
                    if (((1 << {{lh.optIdx(arg)}}) & opt_flags) != 0)
                        op::kernel::stage_add({{stage_slot(arg, "chunk_colouring")}}, op2_local{{arg.id}}, {{dat_dim_w(lh.dat(arg))}});
            {% else %}
                    op::kernel::stage_add({{stage_slot(arg, "chunk_colouring")}}, op2_local{{arg.id}}, {{dat_dim_w(lh.dat(arg))}});
            {% endif %}
        {% endfor %}
                }

                __syncthreads();
            }
    {% else %}
            const int op2_n = n;
            for (int op2_pass = 0; op2_pass < op2_colours; ++op2_pass) {
                if (op2_colour == op2_pass) {
                    // Opaque, so this element's address arithmetic is not
                    // hoisted out of the pass loop and kept live through it.
                    const int n = op::kernel::opaque(op2_n);
                    {{kernel_call(true, "chunk_colouring", "chunk_colouring")|indent(20)}}
                }

                __syncthreads();
            }
    {% endif %}
        }
{%- endmacro %}

{#- Stage a chunk's grouped targets in shared memory, apply its elements to
    them, then write each target once.  chunk_atomics clears its slots,
    accumulates into them with shared atomics and flushes them with global
    ones.  chunk_colouring seeds every slot and stores it back, since a
    batch's chunks share no target, and applies its elements by thread
    colour.  Only JIT kernels are built from it. -#}
{%- macro chunk_body(strategy) %}
    {% set dats = groups[strategy].dats %}
    extern __shared__ char op2_stage_smem[];

    {% for dat_id in dats %}
    const bool op2_stage{{loop.index0}}_active = {{stage_group_active(strategy, dat_id)}};
    {% endfor %}

    {% if strategy == "chunk_colouring" %}
    // Physical blocks grid-stride over this batch's chunks, which share no
    // target of any group.  A wavefront batch covers a section instead: its
    // blocks take positions in turn, each once the earlier positions sharing
    // one of its targets are done.
    __shared__ int op2_taken;
    for (int op2_i = op2_wavefront ? op::kernel::wave_take(wave_ticket, chunk_begin, op2_taken)
                                   : chunk_begin + blockIdx.x;
         op2_i < chunk_end;
         op2_i = op2_wavefront ? op::kernel::wave_take(wave_ticket, chunk_begin, op2_taken)
                               : op2_i + gridDim.x) {
        if (op2_wavefront)
            op::kernel::wave_wait(wave_pred_offsets, wave_preds, wave_done, op2_i, wave_epoch);
        const int chunk = chunk_order[op2_i];
    {% else %}
    // Physical blocks grid-stride over this section's chunks; the partition
    // guarantees no chunk spans a section boundary.
    for (int chunk = chunk_begin + blockIdx.x; chunk < chunk_end;
         chunk += gridDim.x) {
    {% endif %}
        const int op2_source_begin = source_offsets[chunk];
        const int op2_source_end = source_offsets[chunk + 1];
        {# Counts up front, slot offsets only at the flush, so no offset
           stays in a register through the user kernel. #}
        const int *op2_chunk_counts =
            stage_counts + chunk * {{dats|length}};
        const int *op2_chunk_slots = slot_offsets + chunk * {{dats|length}};

        // Walk the same region layout the host planner sized this chunk for.
        char *op2_stage_cursor = op2_stage_smem;
    {% for dat_id in dats %}
        {% set dat = lh.dat(dat_id) %}
        const int op2_stage{{loop.index0}}_count = op2_stage{{loop.index0}}_active ? op2_chunk_counts[{{loop.index0}}] : 0;
        {{dat.typ.c()}} *op2_stage{{loop.index0}} = op::kernel::stage_region<{{dat.typ.c()}}>(op2_stage_cursor, op2_stage{{loop.index0}}_count, {{dat_dim_w(dat)}});
    {% endfor %}

    {% if strategy == "chunk_atomics" %}
        // Clear every region before accumulating into it.
        {% for dat_id in dats %}
        op::kernel::stage_clear(op2_stage{{loop.index0}}, op2_stage{{loop.index0}}_count * {{dat_dim_w(lh.dat(dat_id))}}, threadIdx.x, blockDim.x);
        {% endfor %}
        __syncthreads();

        for (int n = op2_source_begin + threadIdx.x; n < op2_source_end;
             n += blockDim.x) {
            {{kernel_call(true, strategy, strategy)|indent(12)}}
        }
    {% else %}
        // Seed every slot from its target, so the elements read and update
        // the targets' current values.
{{stage_slots(strategy, "seed")}}
        __syncthreads();
{{chunk_colour_passes()}}
    {% endif %}

        __syncthreads();

        // One write per distinct target reaches global memory.
{{stage_slots(strategy, "store" if strategy == "chunk_colouring" else "flush")}}

        // Keep the next iteration from reusing memory a warp is still
        // flushing.
        __syncthreads();
    {% if strategy == "chunk_colouring" %}
        if (op2_wavefront)
            op::kernel::wave_signal(wave_done, op2_i, wave_epoch);
    {% endif %}
    }
{%- endmacro %}

{#- The HIP wrappers carry launch bounds: the default block size offline,
    the JIT kernel's own block size as a constant. -#}
{%- macro launch_bounds(jit) -%}
    {%- if config.hip -%}
__launch_bounds__({{"op2_block_size_d" if jit else "128"}})

    [[maybe_unused]] constexpr bool op2_wavefront = op2_wavefront_d != 0;

    (void)start;
    (void)end;
    (void)thread_id;
{{chunk_body(strategy)}}
}
    {% else %}

    for (int i = thread_id + start; i < end; i += blockDim.x * gridDim.x) {
    {% if strategy == "colouring" %}
        int n = col_reord[i];
    {% else %}
        int n = i;
    {% endif %}

        {{kernel_call(jit, strategy)|indent(8)}}

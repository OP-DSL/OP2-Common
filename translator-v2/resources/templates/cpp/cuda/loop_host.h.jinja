{#- Whether any argument in a staged group is active for this launch. -#}
{%- macro stage_group_active(strategy, dat_id) -%}
    {%- set members = groups[strategy].args|selectattr("dat_id", "eq", dat_id)|list -%}
    {%- if members|reject("opt")|list|length > 0 -%}
true
    {%- else -%}
        {%- for arg in members -%}
((1 << {{lh.optIdx(arg)}}) & opt_flags) != 0{{" || " if not loop.last}}
        {%- endfor -%}
    {%- endif -%}
{%- endmacro -%}

{#- A slot's global target as an op::kernel::Ptr; its stride carries the layout, so
    the staging helpers need no AoS/SoA variants. -#}
{%- macro stage_global(arg, dat) -%}
    {%- if dat is soa -%}
op::kernel::Ptr{dat{{arg.dat_id}} + target, op2_stride_dat{{arg.dat_id}}_d}
    {%- else -%}
op::kernel::Ptr{dat{{arg.dat_id}} + target * {{dat_dim_w(dat)}}}
    {%- endif -%}

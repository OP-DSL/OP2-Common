static void op2_k_{{lh.name}}{{variant}}_bind(
    op::gpu::LaunchContext& launch, op_arg *args,
    std::vector<void *>& arguments) {
{% if lh.args|opt|length > 0 %}
    launch.opt_flags = 0;
    {% for arg in lh.args|opt %}
    if (args[{{arg.id}}].opt)
        launch.opt_flags |= 1 << {{lh.optIdx(arg)}};
    {% endfor %}
{% else %}
    (void)args;
{% endif %}

    arguments = {
{{kernel_arguments()}}    };
}

static bool op2_k_{{lh.name}}{{variant}}_register(op::gpu::Loop& loop) {
    namespace kernel = op2_m_{{lh.name}}{{variant}};
    auto& jit = loop.jit();

{% for dat in lh.dats|soa %}
    jit.add_dat_stride_param(
        "op2_{{lh.kernel}}_dat{{dat.id}}_stride_d",
        &kernel::op2_{{lh.kernel}}_dat{{dat.id}}_stride, {{dat.arg_id}},
        &kernel::op2_{{lh.kernel}}_dat{{dat.id}}_stride_d);
{% endfor %}
{% for const in lh.consts %}
    {% if const.dim == 1 %}
    jit.add_param("op2_const_{{const.ptr}}_d", &{{const.ptr}},
        &op2_const_{{const.ptr}}_d, &op2_const_{{const.ptr}}_hash);
    {% else %}
    jit.add_param("op2_const_{{const.ptr}}_d", {{const.ptr}},
        sizeof(op2_const_{{const.ptr}}_d) / sizeof({{const.ptr}}[0]),
        op2_const_{{const.ptr}}_d, &op2_const_{{const.ptr}}_hash);
    {% endif %}
{% endfor %}
{% for arg in lh.args|gbl|read|scalar %}
    jit.add_scalar_arg_param("op2_gbl{{arg.id}}_d",
        &kernel::op2_gbl{{arg.id}}, {{arg.id}});
{% endfor %}
{% if args_gbl_per_thread|length > 0 %}
    jit.add_launch_param("op2_{{lh.kernel}}_gbl_stride_d",
                         op::gpu::ParamSource::global_stride,
                         &kernel::op2_{{lh.kernel}}_gbl_stride_d);
{% endif %}
    jit.add_launch_param("op2_block_size_d", op::gpu::ParamSource::block_size);

    loop.add<op::gpu::{{"Colouring" if strategy == "colouring" else "Simple"}}>(
        "{{strategy}}", op::loop::Default::enabled,
        op::gpu::KernelSource{
            "op2_k_{{lh.name}}{{variant}}_wrapper",
            (const void *)op2_k_{{lh.name}}{{variant}}_wrapper,
            op2_k_{{lh.name}}{{variant}}_src},
        &op2_k_{{lh.name}}{{variant}}_bind);
    return true;
}

static op::gpu::Loop& op2_k_{{lh.name}}{{variant}}_loop() {
    static op::gpu::Loop loop(
        "{{lh.name}}", "c_CUDA", "{{variant_str()}}",
        op::gpu::LoopDescription{ {{"true" if lh is direct else "false"}},
                                  {{"true" if config.gbl_inc_atomic else "false"}} },
        OP_F2C_JIT_HEADERS);
    static const bool registered = op2_k_{{lh.name}}{{variant}}_register(loop);
    (void)registered;
    return loop;
}

void op_par_loop_{{lh.name}}(
    const char *name,
    op_set set,
{% for arg in lh.args %}
    op_arg arg{{arg.id}}{{"," if not loop.last}}
{% endfor %}
) {
    (void)name;
    op_arg args[] = {
{% for arg in lh.args %}
        arg{{arg.id}}{{"," if not loop.last}}
{% endfor %}
    };

    op2_k_{{lh.name}}{{variant}}_loop().invoke(set, args, {{lh.args|length}});
}

static void op2_k_{{lh.name}}{{variant}}_init_globals(
    const op::gpu::GlobalsContext& context, op_arg *args) {
{% for arg in args_gbl_per_thread|select2("min", "max", "work") %}
    static {{arg.typ.c()}} *gbl{{arg.id}}_ref_d = nullptr;
    static int gbl{{arg.id}}_ref_capacity = 0;
    const int gbl{{arg.id}}_ref_dim =
        {{arg.dim if arg.dim is not none else "args[%s].dim" % arg.id}};

    {% if arg is opt %}
    if (args[{{arg.id}}].opt == 1) {
    {% endif %}
    if (gbl{{arg.id}}_ref_capacity < gbl{{arg.id}}_ref_dim) {
        if (gbl{{arg.id}}_ref_d != nullptr)
            CUDA_SAFE_CALL({{api_prefix}}Free(gbl{{arg.id}}_ref_d));
        CUDA_SAFE_CALL({{api_prefix}}Malloc(&gbl{{arg.id}}_ref_d,
            gbl{{arg.id}}_ref_dim * sizeof({{arg.typ.c()}})));
        gbl{{arg.id}}_ref_capacity = gbl{{arg.id}}_ref_dim;
    }

    CUDA_SAFE_CALL({{api_prefix}}MemcpyAsync(
        gbl{{arg.id}}_ref_d, args[{{arg.id}}].data,
        gbl{{arg.id}}_ref_dim * sizeof({{arg.typ.c()}}),
        {{api_prefix}}MemcpyHostToDevice, 0));
    {% if arg is opt %}
    }
    {% endif %}
{% endfor %}
    {{init_gbls()|indent(4)}}
}

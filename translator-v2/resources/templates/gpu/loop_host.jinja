{% set params_rows %}
{% if lh.args|direct(lh)|soa(lh)|length > 0 %}
    op::rt::abi::dat_stride("op2_stride_direct_d", &{{m}}::op2_stride_direct,
        {{lh.args|direct(lh)|soa(lh)|first|attr("id")}}, &{{m}}::op2_stride_direct_d),
{% endif %}
{% for dat in lh.dats|soa if dat is mapped(lh) %}
    op::rt::abi::dat_stride("op2_stride_dat{{dat.id}}_d", &{{m}}::op2_stride_dat{{dat.id}},
        {{dat.arg_id}}, &{{m}}::op2_stride_dat{{dat.id}}_d),
{% endfor %}
{{abi.register_consts()}}
{% for dat in lh.dats if dat.dim is none %}
    op::rt::abi::dat_dim("op2_dim_dat{{dat.id}}_d", &{{m}}::op2_dim_dat{{dat.id}}, {{dat.arg_id}}),
{% endfor %}
{% for arg in lh.args|gbl|read|scalar %}
    op::rt::abi::scalar_global("op2_gbl{{arg.id}}_d", &{{m}}::op2_gbl{{arg.id}}, {{arg.id}}),
{% endfor %}
{% for arg in lh.args|gbl|read|reject("scalar") %}
    op::rt::abi::global<{{arg.typ.c()}}>("op2_gbl{{arg.id}}_d", {{arg.id}}, {{"true" if arg in gbls_by_value else "false"}}),
{% endfor %}
{% endset %}
{% if params_rows|trim %}
static const op::rt::abi::Param op2_k_{{lh.name}}{{variant}}_params[] = {
{{params_rows}}};

{% endif %}
{% for strategy in strategies if strategy in chunk_strategies %}
static constexpr std::array<op::rt::abi::ArgGroup, {{groups[strategy].args|length}}> op2_k_{{lh.name}}{{variant}}_{{strategy}}_groups = {{"{{"}}
    {% for arg in groups[strategy].args %}
    op::rt::abi::ArgGroup{ {{arg.id}}, {{groups[strategy].group(arg)}} },
    {% endfor %}
{{"}}"}};

{% endfor %}
static const op::rt::abi::gpu::Family op2_k_{{lh.name}}{{variant}}_families[] = {
{% for strategy in strategies %}
    {"{{strategy}}", "op2_k_{{lh.name}}{{variant}}_{{strategy}}_wrapper",
     {{"(const void *)op2_k_%s%s_%s_wrapper" % (lh.name, variant, strategy) if strategy in offline_strategies else "nullptr"}},
     op2_k_{{lh.name}}{{variant}}_{{strategy}}_src,
     {{"op::rt::abi::ArgGroups{op2_k_%s%s_%s_groups, %d}" % (lh.name, variant, strategy, groups[strategy].dats|length) if strategy in chunk_strategies else "{}"}}},
{% endfor %}
};

static op::rt::abi::gpu::Loop op2_k_{{lh.name}}{{variant}}_loop{
    "{{lh.name}}", "{{target.name}}", "{{variant_str()}}",
    {{"true" if lh is direct else "false"}}, {{"true" if config.gbl_inc_atomic else "false"}}, {{"true" if per_thread else "false"}},
    {{"op2_k_%s%s_params" % (lh.name, variant) if params_rows|trim else "{}"}},
    op2_k_{{lh.name}}{{variant}}_families,
    &op2_k_{{lh.name}}{{variant}}_bind,
    &op::rt::kernel::gpu::calls,
    OP_KERNEL_JIT_HEADERS};

{{abi.entry()}}
    op_set set,
{% for arg in lh.args %}
    op_arg arg{{arg.id}}{{"," if not loop.last}}
{% endfor %}
) {
{{abi.entry_prologue()}}
    op_arg args[] = {
{% for arg in lh.args %}
        arg{{arg.id}}{{"," if not loop.last}}
{% endfor %}
    };

    op::rt::abi::gpu::invoke(op2_k_{{lh.name}}{{variant}}_loop, set, args, {{lh.args|length}});
}

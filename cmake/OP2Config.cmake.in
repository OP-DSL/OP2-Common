@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# What this OP2 was built with; only what's used gets re-found below.
# CACHE INTERNAL, as in-tree: op2_add_app_variants() reads these from inside
# a function(), so a plain variable wouldn't reach a sibling directory.
set(OP2_HAS_MPI            "@MPI_FOUND@"             CACHE INTERNAL "")
set(OP2_HAS_OPENMP_CXX     "@OpenMP_CXX_FOUND@"      CACHE INTERNAL "")
set(OP2_HAS_OPENMP_FORTRAN "@OpenMP_Fortran_FOUND@"  CACHE INTERNAL "")
set(OP2_HAS_CUDA           "@CUDAToolkit_FOUND@"     CACHE INTERNAL "")
set(OP2_HAS_HIP            "@hip_FOUND@"             CACHE INTERNAL "")
set(OP2_HAS_HDF5           "@HDF5_FOUND@"            CACHE INTERNAL "")
set(OP2_HAS_HDF5_PARALLEL  "@OP2_HDF5_IS_PARALLEL@"  CACHE INTERNAL "")
set(OP2_HAS_PTSCOTCH       "@PTScotch_FOUND@"        CACHE INTERNAL "")
set(OP2_HAS_PARMETIS       "@ParMETIS_FOUND@"        CACHE INTERNAL "")
set(OP2_HAS_KAHIP          "@KaHIP_FOUND@"           CACHE INTERNAL "")

# Languages the consumer must have enabled: CXX always (every op2:: target
# carries cxx_std_20), C too when parallel HDF5 is linked (needs MPI::MPI_C).
# Checked up front for one clear message instead of an obscure failure deep
# inside FindMPI/hdf5-targets.cmake.
set(_op2_required_languages CXX)
if(OP2_HAS_HDF5_PARALLEL)
    list(APPEND _op2_required_languages C)
endif()
foreach(_op2_lang IN LISTS _op2_required_languages)
    if(NOT CMAKE_${_op2_lang}_COMPILER_LOADED)
        string(REPLACE ";" " " _op2_langs "${_op2_required_languages}")
        set(OP2_FOUND FALSE)
        set(OP2_NOT_FOUND_MESSAGE "OP2 requires the ${_op2_lang} language, which the consuming project has not enabled. This OP2 build needs: ${_op2_langs}. Add them to your project() call, e.g. project(myapp LANGUAGES ${_op2_langs}).")
        return()
    endif()
endforeach()
unset(_op2_lang)
unset(_op2_required_languages)

# Each dependency below defaults to the one OP2 was built against, overridable
# by the package's usual knobs. OP2's libraries are static and get relinked by
# the consumer, so finding a *different* build is what breaks, not finding
# none - and a path that's since moved is ignored, not pinned to.

# Only the components something in the link graph names: FindMPI/FindOpenMP
# fail outright on a component whose language isn't enabled, not just waste
# time on it.
if(OP2_HAS_MPI)
    set(_op2_mpi_components CXX)
    if(OP2_HAS_HDF5_PARALLEL)
        list(APPEND _op2_mpi_components C)
    endif()

    # MPI has no cross-implementation ABI (OP2's objects reference this
    # implementation's symbols directly), so a different MPI gives undefined
    # references. The wrapper determines everything else FindMPI derives, so
    # defaulting it reproduces OP2's own result; MPI_HOME or an explicit
    # MPI_<lang>_COMPILER suppresses the default.
    if(NOT MPI_HOME AND NOT DEFINED ENV{MPI_HOME})
        if(NOT MPI_CXX_COMPILER AND EXISTS "@MPI_CXX_COMPILER@")
            set(MPI_CXX_COMPILER "@MPI_CXX_COMPILER@")
        endif()
        if(NOT MPI_C_COMPILER AND EXISTS "@MPI_C_COMPILER@")
            set(MPI_C_COMPILER "@MPI_C_COMPILER@")
        endif()
    endif()

    find_dependency(MPI COMPONENTS ${_op2_mpi_components})
    unset(_op2_mpi_components)
endif()

# Each language independently: this OP2 may have been built with OpenMP for
# only one of them.
set(_op2_openmp_components "")
if(OP2_HAS_OPENMP_CXX)
    list(APPEND _op2_openmp_components CXX)
endif()
if(OP2_HAS_OPENMP_FORTRAN AND CMAKE_Fortran_COMPILER_LOADED)
    list(APPEND _op2_openmp_components Fortran)
endif()
if(_op2_openmp_components)
    find_dependency(OpenMP COMPONENTS ${_op2_openmp_components})
endif()
unset(_op2_openmp_components)

if(OP2_HAS_CUDA)
    # Mixing CUDA runtime major versions in one binary is unsupported, and
    # OP2's device objects were emitted by the toolkit recorded here. A
    # default only - FindCUDAToolkit consults an enabled CUDA language and
    # CMAKE_CUDA_COMPILER first, so a consumer compiling its own .cu files
    # still gets the toolkit it compiles with.
    if(NOT CUDAToolkit_ROOT AND NOT DEFINED ENV{CUDAToolkit_ROOT}
            AND IS_DIRECTORY "@CUDAToolkit_LIBRARY_ROOT@")
        set(CUDAToolkit_ROOT "@CUDAToolkit_LIBRARY_ROOT@")
    endif()
    find_dependency(CUDAToolkit)
endif()

if(OP2_HAS_HIP)
    # As for CUDA: OP2's device objects are tied to this ROCm's runtime.
    if(NOT hip_DIR AND IS_DIRECTORY "@hip_DIR@")
        set(hip_DIR "@hip_DIR@")
    endif()
    find_dependency(hip CONFIG)
endif()

# HDF5 gets a check on top of its default: unlike MPI (undefined references)
# or CUDA/HIP (rejected at generate time), an HDF5 mismatch can link cleanly
# and misbehave, since OP2 calls version-specific symbols and links it
# statically. The version check defers to HDF5's own compatibility policy -
# its config-version file accepts the same major.minor series from this
# patch level up.
if(OP2_HAS_HDF5)
    # HDF5 ships its own config package, so HDF5_ROOT/HDF5_DIR/CMAKE_PREFIX_PATH
    # steer it as usual; failing those, default to where OP2 found it.
    if(NOT HDF5_DIR AND IS_DIRECTORY "@HDF5_DIR@")
        set(HDF5_DIR "@HDF5_DIR@")
    endif()

    set(_op2_hdf5_version "@HDF5_VERSION@")
    find_package(HDF5 ${_op2_hdf5_version} CONFIG QUIET COMPONENTS C)
    if(NOT HDF5_FOUND)
        set(OP2_FOUND FALSE)
        set(OP2_NOT_FOUND_MESSAGE "OP2 was built against HDF5 ${_op2_hdf5_version}, and no compatible HDF5 was found - HDF5 counts only its own major.minor series as compatible. Point HDF5_ROOT or CMAKE_PREFIX_PATH at a matching build, or rebuild OP2 against the HDF5 you have.")
        return()
    endif()

    # HDF5's config sets HDF5_ENABLE_PARALLEL; CMake's FindHDF5 sets
    # HDF5_IS_PARALLEL.  Accept either, as OP2HDF5.cmake does.
    if(DEFINED HDF5_ENABLE_PARALLEL)
        set(_op2_hdf5_parallel "${HDF5_ENABLE_PARALLEL}")
    else()
        set(_op2_hdf5_parallel "${HDF5_IS_PARALLEL}")
    endif()
    if(OP2_HAS_HDF5_PARALLEL AND NOT _op2_hdf5_parallel)
        set(OP2_FOUND FALSE)
        set(OP2_NOT_FOUND_MESSAGE "OP2 was built against a parallel (MPI) HDF5, but the HDF5 found here (${_op2_hdf5_version}) is serial and so lacks the MPI entry points OP2's MPI variants call. Point HDF5_ROOT or CMAKE_PREFIX_PATH at a parallel build, or rebuild OP2 against this one.")
        return()
    endif()
    unset(_op2_hdf5_parallel)
    unset(_op2_hdf5_version)
endif()

# ---------------------------------------------------------------------------
# Mesh partitioners
# ---------------------------------------------------------------------------
# Nothing to do: partitioners are linked by library path, so install(EXPORT)
# pinned the exact artefacts in OP2Targets.cmake and none is searched for
# again - deliberate, since they aren't ABI-stable across builds. Rebuild OP2
# to change partitioner.

include("${CMAKE_CURRENT_LIST_DIR}/OP2Targets.cmake")

# ---------------------------------------------------------------------------
# App-build support - op2_add_app_variants() and op2_translate()
# ---------------------------------------------------------------------------
# Installed layout, following whatever CMAKE_INSTALL_* the build used:
#   <libdir>/cmake/op2/OP2Config.cmake            (this file)
#   <bindir>/op2-translator                       (launcher on PATH)
#   <libexecdir>/op2/translator/{pkg,fpp,resources}
#   <includedir>/op2/                             (OP2 C/C++ headers)
#
# The @PACKAGE_*@ paths resolve against PACKAGE_PREFIX_DIR via
# configure_package_config_file()'s PATH_VARS, independent of install layout.
set(_op2_translator_pkg_dir "@PACKAGE_OP2_INSTALL_TRANSLATORDIR@/pkg")
set(_op2_translator_reqs_file "@PACKAGE_OP2_INSTALL_TRANSLATORDIR@/requirements.txt")
include("${CMAKE_CURRENT_LIST_DIR}/OP2TranslatorProbe.cmake")

# Plain path, not a genex: the translator consumes it at configure time.
set(OP2_INCLUDE_DIR "@PACKAGE_OP2_INSTALL_INCLUDEDIR@" CACHE INTERNAL "")

include("${CMAKE_CURRENT_LIST_DIR}/OP2AppSupport.cmake")

check_required_components(OP2)
